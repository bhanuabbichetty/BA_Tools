<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        x:Name="MainWindow">

    <Window.Resources>

        <!-- ── Slim Scrollbar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── Primary Button (Blue) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Button (Dark outline) ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── GreenButton alias (same as Primary for this tool) ── -->
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ── DataGrid ── -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Foreground" Value="#C8C8E8"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowBackground" Value="#0E0E1A"/>
            <Setter Property="AlternatingRowBackground" Value="#0A0A12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowHeight" Value="34"/>
        </Style>

        <!-- ── DataGrid Column Header ── -->
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- ── DataGrid Cell ── -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#C8C8E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── DataGrid Row ── -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── CheckBox Style (DataGrid inline) ── -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════
         OUTER SHELL — full dark, no OS chrome, rounded
    ════════════════════════════════════════════════════════ -->
    <Border Background="#0A0A12"
            CornerRadius="12"
            BorderBrush="#0A0A12"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 ROW 0 — TITLE BAR
            ══════════════════════════════════════════════ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BA Logo Badge -->
                    <Border Grid.Column="0"
                            Background="#1976D2"
                            CornerRadius="8"
                            Width="42" Height="42"
                            VerticalAlignment="Center">
                        <TextBlock Text="BA"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="WORKSET 3D VIEW CREATOR"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <!-- Close Button -->
                    <Button x:Name="btnClose"
                            Grid.Column="2"
                            Content="Close"
                            Style="{StaticResource CloseButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 1 — SUBTITLE
            ══════════════════════════════════════════════ -->
            <TextBlock Grid.Row="1"
                       Text="Select worksets to create isolated 3D views"
                       FontSize="12" FontFamily="Segoe UI"
                       Foreground="#FFCDA2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- ══════════════════════════════════════════
                 ROW 2 — MAIN CONTENT
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="16,8,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Title & Actions Bar ── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="AVAILABLE WORKSETS"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnSelectAll"
                                Content="SELECT ALL"
                                Width="120" Height="34"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"/>
                        <Button x:Name="btnClearAll"
                                Content="CLEAR ALL"
                                Width="120" Height="34"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </Grid>

                <!-- ── DataGrid ── -->
                <Border Grid.Row="2"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8">
                    <DataGrid x:Name="dgWorksets"
                              Style="{StaticResource DataGridStyle}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              Background="Transparent"
                              BorderThickness="0">
                        <DataGrid.Columns>

                            <!-- Checkbox Column -->
                            <DataGridTemplateColumn Header=" " Width="60">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="16"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{StaticResource CheckBoxStyle}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Workset Name Column -->
                            <DataGridTextColumn Header="Workset Name"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell"
                                           BasedOn="{StaticResource DataGridCellStyle}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#64B5F6"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>

                            <!-- Status Column -->
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="200"
                                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell"
                                           BasedOn="{StaticResource DataGridCellStyle}">
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="Foreground" Value="#808090"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ── Summary Row ── -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtWorksetCount"
                               Grid.Column="0"
                               Text="0 worksets loaded, 0 selected"
                               Foreground="#C8C8E8"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Tip: Click anywhere on a row to select it"
                               Foreground="#606080"
                               FontSize="11" FontStyle="Italic"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ── How it works Info Card ── -->
                <Border Grid.Row="6"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="ℹ  How it works"
                                   Foreground="#1976D2"
                                   FontFamily="Segoe UI"
                                   FontWeight="SemiBold"
                                   FontSize="10"
                                   Margin="0,0,0,8"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Foreground="#808090" FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,3">
                                <Run Foreground="#FFCDA2" FontWeight="Bold">1.</Run>
                                <Run> Click on any workset row to select / deselect it</Run>
                            </TextBlock>
                            <TextBlock Foreground="#808090" FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,3">
                                <Run Foreground="#FFCDA2" FontWeight="Bold">2.</Run>
                                <Run> Click CREATE VIEWS to generate isolated 3D views</Run>
                            </TextBlock>
                            <TextBlock Foreground="#808090" FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,3">
                                <Run Foreground="#FFCDA2" FontWeight="Bold">3.</Run>
                                <Run> Views will be named the same as the workset name</Run>
                            </TextBlock>
                            <TextBlock Foreground="#808090" FontFamily="Segoe UI" FontSize="10" Margin="0,0,0,3">
                                <Run Foreground="#FFCDA2" FontWeight="Bold">4.</Run>
                                <Run> Each view will show ONLY that workset's elements</Run>
                            </TextBlock>
                            <TextBlock Foreground="#808090" FontFamily="Segoe UI" FontSize="10">
                                <Run Foreground="#FFCDA2" FontWeight="Bold">5.</Run>
                                <Run> Existing views with the same name will be skipped</Run>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ══════════════════════════════════════════
                 ROW 3 — FOOTER
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status -->
                    <TextBlock x:Name="txtStatus"
                               Grid.Column="0"
                               Text="Select worksets to create 3D views"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="#1976D2"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Cancel -->
                    <Button x:Name="btnCancel"
                            Grid.Column="2"
                            Content="CANCEL"
                            Width="120" Height="36"
                            Style="{StaticResource SecondaryButton}"/>

                    <!-- Create Views -->
                    <Button x:Name="btnCreate"
                            Grid.Column="4"
                            Content="CREATE VIEWS"
                            Width="200" Height="36"
                            Style="{StaticResource GreenButton}"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
