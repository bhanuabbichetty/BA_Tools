<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools" 
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#14141C"
        x:Name="MainWindow">
    
    <Window.Resources>
        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- SECONDARY BUTTON -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3C3C46"/>
        </Style>

        <!-- GREEN BUTTON -->
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- LABEL TEXT -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0C0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- DATAGRID -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E28"/>
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowBackground" Value="#1E1E28"/>
            <Setter Property="AlternatingRowBackground" Value="#252530"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <!-- DATAGRID HEADER -->
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C2C36"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <!-- DATAGRID CELL -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#E0E0E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DATAGRID ROW - HOVER ONLY, NO SELECTION HIGHLIGHT -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C36"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CHECKBOX STYLE -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1E1E28" BorderBrush="#1976D2" BorderThickness="0,0,0,2">
            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1976D2" Width="40" Height="40" VerticalAlignment="Center">
                    <TextBlock Text="BA" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" 
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="WORKSET 3D VIEW CREATOR" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Select worksets to create isolated 3D views" FontFamily="Segoe UI" FontSize="11" Foreground="#808090" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="25,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE & ACTIONS -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="AVAILABLE WORKSETS" Foreground="#1976D2" 
                           FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnSelectAll" Content="SELECT ALL" Width="120" Height="36" 
                            Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                    <Button x:Name="btnClearAll" Content="CLEAR ALL" Width="120" Height="36" 
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>

            <!-- DATAGRID - CLICK ANYWHERE ON ROW TO SELECT -->
            <DataGrid x:Name="dgWorksets" Grid.Row="1" 
                      Style="{StaticResource DataGridStyle}" 
                      RowStyle="{StaticResource DataGridRowStyle}">
                <DataGrid.Columns>
                    <!-- CHECKBOX COLUMN -->
                    <DataGridTemplateColumn Header=" " Width="60">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                         Style="{StaticResource CheckBoxStyle}"
                                         HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- WORKSET NAME COLUMN -->
                    <DataGridTextColumn Header="Workset Name" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="#64B5F6"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <!-- STATUS COLUMN -->
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="200" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="FontStyle" Value="Italic"/>
                                <Setter Property="Foreground" Value="#B0B0C0"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- SUMMARY -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtWorksetCount" Grid.Column="0" 
                           Text="0 worksets loaded, 0 selected" 
                           Foreground="#B0B0C0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" 
                           Text="Tip: Click anywhere on a row to select it" 
                           Foreground="#808090" FontSize="11" FontStyle="Italic" 
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- INFO PANEL -->
            <Border Grid.Row="3" Background="#252530" BorderBrush="#1976D2" BorderThickness="1" 
                    CornerRadius="3" Padding="15,10" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelText}" Foreground="#FFFFFF" FontWeight="Bold" 
                               FontSize="13" Margin="0,0,0,6">
                        How it works:
                    </TextBlock>
                    <StackPanel Margin="15,0,0,0">
                        <TextBlock Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,3">
                             1. Click on any workset row to select/deselect it
                        </TextBlock>
                        <TextBlock Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,3">
                             2. Click CREATE VIEWS to generate 3D views
                        </TextBlock>
                        <TextBlock Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,3">
                             3. Views will be named same as the workset name
                        </TextBlock>
                        <TextBlock Style="{StaticResource LabelText}" FontSize="11" Margin="0,0,0,3">
                             4. Each view will show ONLY that workset's elements
                        </TextBlock>
                        <TextBlock Style="{StaticResource LabelText}" FontSize="11">
                             5. Existing views will be skipped
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#1E1E28" BorderBrush="#1976D2" BorderThickness="0,2,0,0">
            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" Grid.Column="0" 
                           Text="Select worksets to create 3D views" 
                           FontFamily="Segoe UI" FontSize="13" Foreground="#B0B0C0" VerticalAlignment="Center"/>
                <Button x:Name="btnCancel" Grid.Column="2" Content="CANCEL" 
                        Width="120" Height="50" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnCreate" Grid.Column="4" Content="CREATE VIEWS" 
                        Width="200" Height="50" Style="{StaticResource GreenButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
