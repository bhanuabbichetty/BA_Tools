<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="800" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        x:Name="MainWindow">

    <Window.Resources>

        <!-- ── Slim Scrollbar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── Primary Button (Blue) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Button (Dark outline) ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark CheckBox ── -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8C8E8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBorder"
                                    Width="16"
                                    Height="16"
                                    Background="#0A0A12"
                                    BorderBrush="#1976D2"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="checkMark"
                                      Data="M 0,4 L 3,7 L 8,0"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Margin="1"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark TextBox ── -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Foreground" Value="#C8C8E8"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#C8C8E8"/>
        </Style>

        <!-- ── Dark ComboBox ── -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- ── Dark ListBox ── -->
        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Foreground" Value="#C8C8E8"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ── Section Label ── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ── Field Label ── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#808090"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════
         OUTER SHELL — full dark, no OS chrome, rounded
    ════════════════════════════════════════════════════════ -->
    <Border Background="#0A0A12"
            CornerRadius="12"
            BorderBrush="#0A0A12"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 ROW 0 — TITLE BAR
            ══════════════════════════════════════════════ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BA Logo Badge -->
                    <Border Grid.Column="0"
                            Background="#1976D2"
                            CornerRadius="8"
                            Width="42" Height="42"
                            VerticalAlignment="Center">
                        <TextBlock Text="BA"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="TRANSFER VIEW TEMPLATES"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <!-- Close Button -->
                    <Button x:Name="btnClose"
                            Grid.Column="2"
                            Content="Close"
                            Style="{StaticResource CloseButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 1 — SUBTITLE
            ══════════════════════════════════════════════ -->
            <TextBlock Grid.Row="1"
                       Text="Copy view templates between projects"
                       FontSize="12" FontFamily="Segoe UI"
                       Foreground="#FFCDA2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- ══════════════════════════════════════════
                 ROW 2 — MAIN CONTENT
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="16,8,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────────────────────────────────────────
                     LEFT PANEL — Project Selection
                ───────────────────────────────────────────── -->
                <Border Grid.Column="0"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Title -->
                        <TextBlock Grid.Row="0"
                                   Text="PROJECT SELECTION"
                                   Style="{StaticResource SectionLabel}"/>

                        <!-- Copy From label -->
                        <TextBlock Grid.Row="2"
                                   Text="Copy From:"
                                   Style="{StaticResource FieldLabel}"/>

                        <!-- Copy From ComboBox -->
                        <ComboBox x:Name="cmbCopyFrom"
                                  Grid.Row="4"
                                  Height="35"
                                  Style="{StaticResource DarkComboBox}"/>

                        <!-- Copy To label -->
                        <TextBlock Grid.Row="6"
                                   Text="Copy To:"
                                   Style="{StaticResource FieldLabel}"/>

                        <!-- Copy To ComboBox -->
                        <ComboBox x:Name="cmbCopyTo"
                                  Grid.Row="8"
                                  Height="35"
                                  Style="{StaticResource DarkComboBox}"/>

                        <!-- Override CheckBox -->
                        <CheckBox x:Name="chkOverride"
                                  Grid.Row="10"
                                  Content="Override existing templates"
                                  Style="{StaticResource DarkCheckBox}"
                                  IsChecked="True"/>

                        <!-- Divider -->
                        <Rectangle Grid.Row="11"
                                   Fill="#1976D2" Height="1"
                                   Opacity="0.3"
                                   VerticalAlignment="Bottom"/>

                        <!-- How it works Info Card -->
                        <Border Grid.Row="12"
                                Background="#0A0A12"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Padding="12,10"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="ℹ  How it works"
                                           Foreground="#1976D2"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           FontFamily="Segoe UI"
                                           Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#FFCDA2"
                                           FontSize="9"
                                           FontFamily="Segoe UI"
                                           LineHeight="14">
                                    Select source and destination projects, then choose which view templates to transfer.
                                    <LineBreak/><LineBreak/>
                                    <Run Foreground="#FFCDA2" FontWeight="Bold">Override:</Run>
                                    <Run> Replaces existing templates with same names and reassigns them to views.</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- ─────────────────────────────────────────
                     RIGHT PANEL — View Templates List
                ───────────────────────────────────────────── -->
                <Border Grid.Column="2"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Info Panel -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="txtTemplateCount"
                                           Text="Select projects to load templates"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"/>
                                <TextBlock x:Name="txtSelectedCount"
                                           Text="0 templates selected"
                                           Foreground="#1976D2"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Filter and Selection Buttons -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtFilter"
                                     Grid.Column="0"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="32"/>

                            <Button x:Name="btnSelectAll"
                                    Grid.Column="2"
                                    Content="SELECT ALL"
                                    Width="100" Height="32"
                                    Style="{StaticResource SecondaryButton}"/>

                            <Button x:Name="btnSelectNone"
                                    Grid.Column="4"
                                    Content="CLEAR"
                                    Width="80" Height="32"
                                    Style="{StaticResource SecondaryButton}"/>
                        </Grid>

                        <!-- Templates ListBox -->
                        <Border Grid.Row="4"
                                Background="#0A0A12"
                                BorderBrush="#1E1E2E"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ListBox x:Name="lstTemplates"
                                     Style="{StaticResource DarkListBox}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Multiple">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource DarkCheckBox}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Margin="5,5">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#C8C8E8"
                                                       FontSize="11"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                    </Grid>
                </Border>

            </Grid>

            <!-- ══════════════════════════════════════════
                 ROW 3 — FOOTER
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status -->
                    <TextBlock x:Name="txtStatus"
                               Grid.Column="0"
                               Text="Ready — Select source and destination projects"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#1976D2"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Transfer Button -->
                    <Button x:Name="btnTransfer"
                            Grid.Column="1"
                            Content="TRANSFER TEMPLATES"
                            Width="210" Height="36"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
