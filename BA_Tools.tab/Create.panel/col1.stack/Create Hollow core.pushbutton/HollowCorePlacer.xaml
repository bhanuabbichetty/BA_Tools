<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools" 
        Width="560" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#14141C">
    
    <Window.Resources>
        <!-- Primary Button Style (Blue) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2196F3"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#404050"/>
                    <Setter Property="Foreground" Value="#707080"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style (Gray) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3C3C46"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4C4C56"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style with HIGH CONTRAST and VISIBLE TEXT -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2C2C36"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="#00FFFF"/>
            <Setter Property="SelectionBrush" Value="#1976D2"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00FFFF"/>
                    <Setter Property="Background" Value="#383842"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1E1E28" BorderBrush="#1976D2" BorderThickness="0,0,0,2">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo/Icon -->
                <Border Grid.Column="0" Background="#1976D2" CornerRadius="3" 
                        Width="45" Height="45" VerticalAlignment="Center">
                    <TextBlock Text="BA" FontSize="18" FontWeight="Bold" 
                             Foreground="White" HorizontalAlignment="Center" 
                             VerticalAlignment="Center" FontFamily="Segoe UI"/>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="HOLLOW CORE PLACER" FontSize="18" 
                             FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="Place hollow core slabs below floor" 
                             FontSize="10" Foreground="#808090" FontFamily="Segoe UI" 
                             Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button x:Name="btnClose" Grid.Column="2" Content="Close" 
                        Style="{StaticResource SecondaryButton}" 
                        Width="85" Height="32" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="20,20,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Floor Info Panel -->
            <Border Grid.Row="0" Background="#1E1E28" CornerRadius="3" 
                    BorderBrush="#1976D2" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📐" FontSize="20" 
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SELECTED FLOOR" 
                                 Foreground="#808090" 
                                 FontFamily="Segoe UI" 
                                 FontSize="9"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtFloorInfo" 
                                 Text="Selected: Floor (ID: 12345)" 
                                 Foreground="White" 
                                 FontFamily="Segoe UI" 
                                 FontSize="11"
                                 FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Z Offset Input -->
            <Border Grid.Row="1" Background="#1E1E28" CornerRadius="3" 
                    BorderBrush="#1976D2" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                             Text="Z OFFSET (mm) — OPTIONAL" 
                             Foreground="#fdfdfc" 
                             FontFamily="Segoe UI" 
                             FontSize="10" 
                             FontWeight="Bold"
                             Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" 
                             Text="Leave 0 for floor bottom | Negative = below | Positive = above" 
                             Foreground="#B0B0B0" 
                             FontFamily="Segoe UI" 
                             FontSize="9"
                             Margin="0,0,0,10"/>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtZOffset" 
                               Grid.Column="0"
                               Style="{StaticResource ModernTextBox}"
                               Text="0"
                               VerticalContentAlignment="Center"
                               Height="42"/>

                        <TextBlock Grid.Column="1" 
                                 Text="mm" 
                                 Foreground="White" 
                                 FontFamily="Segoe UI" 
                                 FontSize="12"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"
                                 Margin="12,0,0,0"/>
                    </Grid>

                    <!-- Rotation Option -->
                    <CheckBox x:Name="chkRotate90" 
                            Grid.Row="3"
                            Content="Rotate 90° (if span direction is wrong)" 
                            Foreground="White"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            Margin="0,0,0,0"
                            Padding="8,4">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="checkBorder"
                                                        Width="20" 
                                                        Height="20" 
                                                        Background="#14141C"
                                                        BorderBrush="#808090"
                                                        BorderThickness="2"
                                                        CornerRadius="3"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <Path x:Name="checkMark"
                                                          Data="M 0,5 L 5,10 L 12,0"
                                                          Stroke="White"
                                                          StrokeThickness="2"
                                                          Visibility="Collapsed"
                                                          Margin="2"/>
                                                </Border>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="checkBorder" Property="Background" Value="#1976D2"/>
                                                    <Setter TargetName="checkBorder" Property="BorderBrush" Value="#1976D2"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="checkBorder" Property="BorderBrush" Value="#2196F3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>
            </Border>

            <!-- Family Type Selection Header -->
            <Border Grid.Row="2" Background="#1E1E28" CornerRadius="3" 
                    BorderBrush="#1976D2" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🏗️" FontSize="20" 
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SELECT HOLLOW CORE FAMILY" 
                                 Foreground="#808090" 
                                 FontFamily="Segoe UI" 
                                 FontSize="9"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtFamilyCount" 
                                 Text="Available: 0 family types" 
                                 Foreground="#1976D2" 
                                 FontFamily="Segoe UI" 
                                 FontSize="11"
                                 FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Family Type List -->
            <Border Grid.Row="3" Background="#1E1E28" CornerRadius="3" 
                    BorderBrush="#1976D2" BorderThickness="1">
                <Border Background="#14141C" Margin="1" CornerRadius="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lstFamilyTypes" Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding DisplayText}" 
                                               IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                               GroupName="FamilySelection"
                                               Foreground="White"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               Margin="0,2"
                                               Padding="12,10">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="itemBorder"
                                                                    Background="#1E1E28"
                                                                    BorderBrush="#404050"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Padding="12,10"
                                                                    Margin="0,2">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <!-- Custom Radio Button -->
                                                                    <Border x:Name="radioBorder"
                                                                            Width="20" 
                                                                            Height="20" 
                                                                            Background="#14141C"
                                                                            BorderBrush="#808090"
                                                                            BorderThickness="2"
                                                                            CornerRadius="10"
                                                                            Margin="0,0,12,0"
                                                                            VerticalAlignment="Center">
                                                                        <Ellipse x:Name="radioMark"
                                                                               Width="10"
                                                                               Height="10"
                                                                               Fill="White"
                                                                               Visibility="Collapsed"/>
                                                                    </Border>
                                                                    <!-- Content -->
                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="radioMark" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="radioBorder" Property="Background" Value="#1976D2"/>
                                                                    <Setter TargetName="radioBorder" Property="BorderBrush" Value="#1976D2"/>
                                                                    <Setter TargetName="itemBorder" Property="Background" Value="#2C2C36"/>
                                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#1976D2"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="radioBorder" Property="BorderBrush" Value="#2196F3"/>
                                                                    <Setter TargetName="itemBorder" Property="Background" Value="#28282E"/>
                                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#2196F3"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>

        <!-- FOOTER: Action Buttons -->
        <Border Grid.Row="2" Background="#1E1E28" BorderBrush="#2C2C36" 
                BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStatus" Grid.Column="0" 
                         Text="Select a hollow core family type" 
                         Foreground="#1976D2" FontFamily="Segoe UI" 
                         FontSize="11" VerticalAlignment="Center"/>

                <Button x:Name="btnCancel" Content="Cancel" 
                        Style="{StaticResource SecondaryButton}" 
                        Grid.Column="1" Width="120" Height="40" Margin="0,0,10,0"/>
                <Button x:Name="btnPlace" Content="PLACE HOLLOW CORES" 
                        Style="{StaticResource PrimaryButton}" 
                        Grid.Column="2" Width="200" Height="40"
                        IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
