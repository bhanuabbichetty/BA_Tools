<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="600" Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ── Slim Scrollbar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── Primary Button (Blue) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Button (Dark outline) ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button ("Close" text, blue outline) ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════
         OUTER SHELL — full dark, no OS chrome, rounded
    ════════════════════════════════════════════════════════ -->
    <Border Background="#0A0A12"
            CornerRadius="12"
            BorderBrush="#0A0A12"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 ROW 0 — TITLE BAR (drag to move)
            ══════════════════════════════════════════════ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 42 x 42 Logo badge -->
                    <Border Grid.Column="0"
                            Background="#1976D2"
                            CornerRadius="8"
                            Width="42" Height="42"
                            VerticalAlignment="Center">
                        <TextBlock Text="BA"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Heading FontSize=18 -->
                    <TextBlock Grid.Column="1"
                               Text="ACQUIRE COORDINATES"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <!-- Close button -->
                    <Button x:Name="btnClose"
                            Grid.Column="2"
                            Content="Close"
                            Style="{StaticResource CloseButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 1 — SUBTITLE
            ══════════════════════════════════════════════ -->
            <TextBlock Grid.Row="1"
                       Text="Match coordinates from linked models"
                       FontSize="10"
                       FontFamily="Segoe UI"
                       Foreground="#FFCDA2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- ══════════════════════════════════════════
                 ROW 2 — SCROLLABLE MAIN CONTENT
            ══════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Margin="16,8,16,0"
                          Padding="0,0,4,0">
                <StackPanel>

                    <!-- ── ACQUISITION METHOD CARD ─────────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ACQUISITION METHOD"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>

                            <!-- Visual Position (Recommended) -->
                            <RadioButton x:Name="rbVisualPosition"
                                         IsChecked="True"
                                         GroupName="Method"
                                         Foreground="#C8C8E8"
                                         FontFamily="Segoe UI"
                                         FontSize="12"
                                         Margin="0,0,0,4"
                                         Cursor="Hand">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <StackPanel Orientation="Vertical">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- Radio circle -->
                                                            <Border x:Name="radioBorder"
                                                                    Width="18" Height="18"
                                                                    Background="#0A0A14"
                                                                    BorderBrush="#1976D2"
                                                                    BorderThickness="0.8"
                                                                    CornerRadius="9"
                                                                    Margin="0,0,12,0"
                                                                    VerticalAlignment="Center">
                                                                <Ellipse x:Name="radioMark"
                                                                         Width="8" Height="8"
                                                                         Fill="White"
                                                                         Visibility="Collapsed"/>
                                                            </Border>
                                                            <TextBlock Text="Visual Position (Recommended)"
                                                                       VerticalAlignment="Center"
                                                                       FontFamily="Segoe UI"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Finds where Survey/Project Base Points physically appear in 3D space and matches your points to those locations. Works even if linked model has coordinates at (0,0,0)."
                                                                   FontSize="10"
                                                                   FontFamily="Segoe UI"
                                                                   Foreground="#FFCDA2"
                                                                   Margin="30,4,0,0"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="radioMark" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="radioBorder" Property="Background" Value="#1976D2"/>
                                                            <Setter TargetName="radioBorder" Property="BorderBrush" Value="#1976D2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="radioBorder" Property="BorderBrush" Value="#2196F3"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <!-- Coordinate Values -->
                            <RadioButton x:Name="rbCoordinateValues"
                                         GroupName="Method"
                                         Foreground="#C8C8E8"
                                         FontFamily="Segoe UI"
                                         FontSize="12"
                                         Margin="0,12,0,0"
                                         Cursor="Hand">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <StackPanel Orientation="Vertical">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- Radio circle -->
                                                            <Border x:Name="radioBorder"
                                                                    Width="18" Height="18"
                                                                    Background="#0A0A14"
                                                                    BorderBrush="#1976D2"
                                                                    BorderThickness="0.8"
                                                                    CornerRadius="9"
                                                                    Margin="0,0,12,0"
                                                                    VerticalAlignment="Center">
                                                                <Ellipse x:Name="radioMark"
                                                                         Width="8" Height="8"
                                                                         Fill="White"
                                                                         Visibility="Collapsed"/>
                                                            </Border>
                                                            <TextBlock Text="Coordinate Values"
                                                                       VerticalAlignment="Center"
                                                                       FontFamily="Segoe UI"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Reads coordinate values from linked model and applies them to your model. Only works if linked model has non-zero coordinates."
                                                                   FontSize="10"
                                                                   FontFamily="Segoe UI"
                                                                   Foreground="#FFCDA2"
                                                                   Margin="30,4,0,0"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="radioMark" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="radioBorder" Property="Background" Value="#1976D2"/>
                                                            <Setter TargetName="radioBorder" Property="BorderBrush" Value="#1976D2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="radioBorder" Property="BorderBrush" Value="#2196F3"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                        </StackPanel>
                    </Border>

                    <!-- ── CURRENT COORDINATES CARD ──────────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="YOUR MODEL (CURRENT)"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Survey Point:"
                                           Grid.Row="0" Grid.Column="0"
                                           FontSize="11"
                                           FontFamily="Segoe UI"
                                           Foreground="#A0A0C0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtCurrentSurvey"
                                           Grid.Row="0" Grid.Column="1"
                                           Text="(0.000, 0.000, 0.000)"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Project Base:"
                                           Grid.Row="1" Grid.Column="0"
                                           FontSize="11"
                                           FontFamily="Segoe UI"
                                           Foreground="#A0A0C0"
                                           VerticalAlignment="Center"
                                           Margin="0,8,0,0"/>
                                <TextBlock x:Name="txtCurrentProject"
                                           Grid.Row="1" Grid.Column="1"
                                           Text="(0.000, 0.000, 0.000)"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </Grid>

                            <Button x:Name="btnRefresh"
                                    Content="🔄 REFRESH"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="34"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- ── LINKED MODELS CARD ─────────────────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="LINKED MODELS"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>

                            <!-- ListBox with dark style -->
                            <ListBox x:Name="lstLinkedModels"
                                     Height="180"
                                     Background="#0A0A12"
                                     Foreground="#C8C8E8"
                                     BorderBrush="#1976D2"
                                     BorderThickness="0.8"
                                     FontFamily="Segoe UI"
                                     FontSize="12"
                                     Padding="4">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#C8C8E8"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="itemBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="0.8"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="itemBorder" Property="Background" Value="#1976D2"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="itemBorder" Property="Background" Value="#1A1A2E"/>
                                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="#1976D2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <TextBlock x:Name="txtLinkInfo"
                                       Text="Select a linked model above to see its coordinates"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       Foreground="#FFCDA2"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════
                 ROW 3 — FOOTER
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status -->
                    <TextBlock x:Name="txtStatus"
                               Grid.Column="0"
                               Text="Ready to acquire coordinates"
                               Foreground="#1976D2"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Acquire button -->
                    <Button x:Name="btnAcquire"
                            Grid.Column="1"
                            Content="ACQUIRE FROM SELECTED"
                            Style="{StaticResource PrimaryButton}"
                            Width="200" Height="36"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
