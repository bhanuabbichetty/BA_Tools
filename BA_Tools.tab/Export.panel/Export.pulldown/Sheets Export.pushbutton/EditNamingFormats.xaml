<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        HorizontalContentAlignment="Center"
        ResizeMode="CanResizeWithGrip" 
        Width="1000" Height="600" MinHeight="500"
        Title="Naming Formats" 
        Closing="cancelled"
        Background="#14141C">
    
    <Window.Resources>
        <!-- Modern Button Styles -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2196F3"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#404050"/>
                    <Setter Property="Foreground" Value="#707080"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#3C3C46"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4C4C56"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="FormatterTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding builtin}" Value="True">
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Background" Value="#2A2A38"/>
                    <Setter Property="Foreground" Value="#808090"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ListBox Style -->
        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#0A0A0F"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- ListBox Item Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Label Text Style -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0C0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Header Text Style -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Description Text Style -->
        <Style x:Key="DescriptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#808090"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="250" Width="1*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition MinWidth="500" Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL - Naming Formats List -->
        <Border Grid.Column="0" Background="#1E1E28" BorderBrush="#1976D2" BorderThickness="1" CornerRadius="2" Padding="15">
            <DockPanel>
                <TextBlock Text="NAMING FORMATS" Style="{StaticResource HeaderText}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                
                <!-- Action Buttons -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Duplicate" Height="32" Click="duplicate_namingformat" Style="{StaticResource SecondaryButton}"/>
                        <Button Grid.Column="2" Content="Delete" Height="32" Click="delete_namingformat" Style="{StaticResource SecondaryButton}"/>
                    </Grid>
                    <Button Content="Save" Height="36" Click="save_formats" Style="{StaticResource ModernButton}"/>
                </StackPanel>
                
                <!-- Formats List -->
                <Border Background="#0A0A0F" BorderBrush="#1976D2" BorderThickness="1" CornerRadius="2" Margin="0,0,0,0">
                    <ListBox x:Name="formats_lb" 
                             Style="{StaticResource ModernListBox}"
                             BorderThickness="0"
                             SelectionChanged="namingformat_changed" 
                             SelectionMode="Single" 
                             SelectedIndex="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Border>

        <!-- RIGHT PANEL - Format Editor -->
        <Border Grid.Column="2" Background="#1E1E28" BorderBrush="#1976D2" BorderThickness="1" CornerRadius="2" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="namingformat_edit">
                    
                    <!-- Format Title Section -->
                    <TextBlock Text="FORMAT TITLE" Style="{StaticResource HeaderText}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource DescriptionText}" Margin="0,0,0,8">
                        This is the name of this specific naming format. Give the format a descriptive name that is easy to understand and find. For example: "City of Portland ePermit"
                    </TextBlock>
                    <TextBox x:Name="template_name_tb"
                             Text="{Binding name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormatterTextBox}"/>

                    <!-- Template Section -->
                    <TextBlock Text="TEMPLATE" Style="{StaticResource HeaderText}" Margin="0,20,0,8" />
                    <TextBlock Style="{StaticResource DescriptionText}" Margin="0,0,0,8">
                        This is the actual naming format template. Each "{}" (tag) represents a value that will be filled when creating the name for a PDF file. Pick and choose from the tags listed below and drag them to this box.
                    </TextBlock>
                    <TextBox x:Name="template_tb"
                             Text="{Binding template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormatterTextBox}"
                             AllowDrop="True" 
                             PreviewDrop="stop_drag" 
                             PreviewDragOver="preview_drag"/>

                    <!-- Tags Section -->
                    <TextBlock Text="DRAG AND DROP TAGS" Style="{StaticResource HeaderText}" Margin="0,20,0,8"/>
                    <TextBlock Style="{StaticResource DescriptionText}" Margin="0,0,0,12">
                        Drag and drop from formatters below. Hover over the formatter for description
                    </TextBlock>
                    
                    <Border Background="#0A0A0F" BorderBrush="#1976D2" BorderThickness="1" CornerRadius="2" Padding="12">
                        <ItemsControl x:Name="formatters_wp">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" PreviewMouseLeftButtonDown="start_drag"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="formatter_box" 
                                            Height="24" 
                                            Margin="4,4,0,0" 
                                            Background="#4A4A58" 
                                            BorderThickness="0" 
                                            CornerRadius="3" 
                                            ToolTip="{Binding desc}"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#5A5A68"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding template}" 
                                                   FontFamily="Consolas" 
                                                   FontSize="11"
                                                   Foreground="White" 
                                                   VerticalAlignment="Center" 
                                                   Margin="8,0,8,0" 
                                                   Padding="0,0,0,1" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Orange for index -->
                                        <DataTrigger Binding="{Binding template}" Value="{}{index}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#FF9800" />
                                        </DataTrigger>
                                        <!-- Blue for basic tags -->
                                        <DataTrigger Binding="{Binding template}" Value="{}{number}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#1976D2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{name}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#2A2A3A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{name_dash}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#2A2A3A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{name_underline}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#2A2A3A" />
                                        </DataTrigger>
                                        <!-- Teal for dates -->
                                        <DataTrigger Binding="{Binding template}" Value="{}{current_date}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#00897B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{issue_date}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#00897B" />
                                        </DataTrigger>
                                        <!-- Red for revision -->
                                        <DataTrigger Binding="{Binding template}" Value="{}{rev_number}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#D32F2F" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{rev_desc}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#D32F2F" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{rev_date}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#D32F2F" />
                                        </DataTrigger>
                                        <!-- Purple for project -->
                                        <DataTrigger Binding="{Binding template}" Value="{}{proj_name}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#7B1FA2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{proj_number}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#7B1FA2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{proj_building_name}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#7B1FA2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{proj_issue_date}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#7B1FA2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{proj_org_name}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#7B1FA2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{proj_status}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#7B1FA2" />
                                        </DataTrigger>
                                        <!-- Gray for user/system -->
                                        <DataTrigger Binding="{Binding template}" Value="{}{username}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#616161" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{revit_version}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#616161" />
                                        </DataTrigger>
                                        <!-- Black for parameters -->
                                        <DataTrigger Binding="{Binding template}" Value="{}{sheet_param:PARAM_NAME}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#1A1A22" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{tblock_param:PARAM_NAME}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#1A1A22" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{proj_param:PARAM_NAME}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#1A1A22" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding template}" Value="{}{glob_param:PARAM_NAME}">
                                            <Setter TargetName="formatter_box" Property="Background" Value="#1A1A22" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
