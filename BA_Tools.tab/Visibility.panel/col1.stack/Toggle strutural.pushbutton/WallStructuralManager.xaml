<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="850" Height="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ── Slim Scrollbar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── Primary Button (Blue) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Button (Dark outline) ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button ("Close" text, blue outline) ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox Style ── -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0E0E1A"/>
            <Setter Property="Foreground" Value="#0E0E1A"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- ── TextBox Style ── -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#1976D2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="bd" Property="Background" Value="#0E0E1E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid Style ── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Foreground" Value="#C8C8E8"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#0E0E1A"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A1A2E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#131326"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="8,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════
         OUTER SHELL — full dark, no OS chrome, rounded
    ════════════════════════════════════════════════════════ -->
    <Border Background="#0A0A12"
            CornerRadius="12"
            BorderBrush="#0A0A12"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 ROW 0 — TITLE BAR (drag to move)
            ══════════════════════════════════════════════ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 42 x 42 Logo badge -->
                    <Border Grid.Column="0"
                            Background="#1976D2"
                            CornerRadius="8"
                            Width="42" Height="42"
                            VerticalAlignment="Center">
                        <TextBlock Text="BA"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Heading FontSize=18 -->
                    <TextBlock Grid.Column="1"
                               Text="WALL STRUCTURAL MANAGER"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <!-- Close button -->
                    <Button x:Name="CloseBtn"
                            Grid.Column="2"
                            Content="Close"
                            Style="{StaticResource CloseButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 1 — SUBTITLE
            ══════════════════════════════════════════════ -->
            <TextBlock Grid.Row="1"
                       Text="Manage structural properties of walls in your model"
                       FontSize="10"
                       FontFamily="Segoe UI"
                       Foreground="#FFCDA2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- ══════════════════════════════════════════
                 ROW 2 — STATS & FILTERS
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="16,8,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Stats card -->
                <Border Grid.Row="0"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="16,12"
                        Margin="0,0,0,10">
                    <TextBlock x:Name="StatsText"
                               Text="Total: 0  |  Structural: 0  |  Non-Structural: 0  |  Selected: 0"
                               FontSize="11"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="#1976D2"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Filters card -->
                <Border Grid.Row="1"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="16,14"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Filter:"
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <ComboBox x:Name="FilterCombo"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernComboBox}"
                                  Height="34"/>

                        <TextBlock Grid.Column="2"
                                   Text="Search:"
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="16,0,10,0"/>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="3"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="34"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════
                 ROW 3 — DATAGRID
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    CornerRadius="8"
                    BorderBrush="#1976D2"
                    BorderThickness="0.8"
                    Margin="16,0,16,10">
                <DataGrid x:Name="WallsGrid"
                          Margin="4">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Select"
                                                Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="60"/>
                        <DataGridTextColumn Header="Wall ID"
                                            Binding="{Binding Id}"
                                            Width="80"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Structural"
                                            Binding="{Binding Structural}"
                                            Width="90"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Wall Type"
                                            Binding="{Binding WallType}"
                                            Width="*"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Level"
                                            Binding="{Binding Level}"
                                            Width="120"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Length (m)"
                                            Binding="{Binding Length}"
                                            Width="100"
                                            IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 4 — FOOTER
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="4"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selection buttons -->
                    <Button x:Name="SelectAllBtn"
                            Grid.Column="0"
                            Content="Select All"
                            Style="{StaticResource SecondaryButton}"
                            Width="90" Height="36"
                            Margin="0,0,8,0"/>

                    <Button x:Name="DeselectAllBtn"
                            Grid.Column="1"
                            Content="Clear All"
                            Style="{StaticResource SecondaryButton}"
                            Width="90" Height="36"
                            Margin="0,0,16,0"/>

                    <!-- Spacer -->
                    <Border Grid.Column="2"/>

                    <!-- Action buttons -->
                    <Button x:Name="MakeStructuralBtn"
                            Grid.Column="3"
                            Content="MAKE STRUCTURAL"
                            Style="{StaticResource PrimaryButton}"
                            Width="160" Height="36"
                            Margin="0,0,8,0"/>

                    <Button x:Name="MakeNonStructuralBtn"
                            Grid.Column="4"
                            Content="MAKE NON-STRUCTURAL"
                            Style="{StaticResource SecondaryButton}"
                            Width="180" Height="36"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
