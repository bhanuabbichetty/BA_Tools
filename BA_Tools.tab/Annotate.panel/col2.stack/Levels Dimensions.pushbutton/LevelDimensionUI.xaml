<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Levels Dimensions" Height="760" Width="760" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#FFC8C8E8" FontFamily="Segoe UI" FontSize="12"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <SolidColorBrush x:Key="panel_bg"    Color="#FF0E0E1A"/>
        <SolidColorBrush x:Key="border_soft" Color="#FF1976D2"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource panel_bg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource border_soft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFA0A0C0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="SideBox" TargetType="Border">
            <Setter Property="Background" Value="#FF131326"/>
            <Setter Property="BorderBrush" Value="{StaticResource border_soft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF0E0E1A"/>
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="BorderBrush" Value="#FF1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="8,0,4,0" VerticalAlignment="Center" Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#FFC8C8E8" IsHitTestVisible="False"/>
                                <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="0,5,5,0"><TextBlock Text="▾" Foreground="#FF8888AA" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="#FF0E0E1A" BorderBrush="#FF1976D2" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                    <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF0E0E1A"/>
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource border_soft}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="checkBoxBorder" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,2,0" Background="#FF0E0E1A" BorderBrush="#FF1976D2" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                <TextBlock x:Name="checkMark" Text="✓" Foreground="White" FontSize="10" FontWeight="Bold" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="checkBoxBorder" Property="Background" Value="#FF1976D2"/><Setter TargetName="checkMark" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#FF2196F3"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="checkBoxBorder" Property="Opacity" Value="0.45"/><Setter Property="Foreground" Value="#FF8888AA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1A1A2A"/>
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="BorderBrush" Value="#FF1976D2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

                <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF0E0E1A"/>
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#FF22223A"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#FF1976D2"/><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF8888AA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="32,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="Background" Value="#FF0E0E1A"/>
        </Style>
    </Window.Resources>

    <Border Background="#FF0A0A12" BorderBrush="#FF1976D2" BorderThickness="1" CornerRadius="12" Padding="10">
    <DockPanel Margin="0">
        <Border DockPanel.Dock="Top" Background="#FF0A0A12" BorderBrush="#FF1976D2" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Width="36" Height="36" Background="#FF1976D2" CornerRadius="7" MouseLeftButtonDown="UIe_drag_window">
                    <TextBlock Text="BA" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="LEVELS DIMENSIONS" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" MouseLeftButtonDown="UIe_drag_window"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Close" IsCancel="True" MinWidth="64" Padding="12,6" Background="#FF1A1A2A" Foreground="#FFA0A0C0" BorderBrush="#FF1976D2" BorderThickness="1" Cursor="Hand"/>
                <TextBlock x:Name="UI_txt_subtitle" Grid.Row="1" Grid.ColumnSpan="3" Foreground="#FFFFCDA2" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource SectionCard}" Margin="0,12,0,0" Padding="14,12">
            <Button Content="Place Level Dimensions" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center" Click="UIe_btn_run"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Dimension style -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Border Background="#FF0E0E1A" CornerRadius="10,10,0,0">
                            <TextBlock Text="Dimension style" Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <StackPanel Margin="12,8,12,10">
                            <Label Content="Linear dimension type used for the level strings"/>
                            <ComboBox x:Name="UI_combo_dim_type"
                                      DisplayMemberPath="Label" SelectedValuePath="Id"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Level map -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Border Background="#FF0E0E1A" CornerRadius="10,10,0,0">
                            <TextBlock Text="Level map — pick sides for dimensions &amp; bubbles"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <Grid Margin="12,12,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT -->
                            <Border Grid.Column="0" Style="{StaticResource SideBox}">
                                <StackPanel>
                                    <TextBlock Text="LEFT" FontWeight="Bold" Foreground="#FFC8C8E8"
                                               HorizontalAlignment="Center"/>
                                    <CheckBox x:Name="UI_chk_left_dim" Content="Dimension" IsChecked="True"/>
                                    <CheckBox x:Name="UI_chk_left_bubble" Content="Bubble on" IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <!-- CENTER -->
                            <Border Grid.Column="1" Background="#FF131326"
                                    BorderBrush="#FF1976D2" BorderThickness="1.5" CornerRadius="8" Margin="4">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="▤ LEVELS" FontWeight="Bold" FontSize="14"
                                               Foreground="#FF1976D2" HorizontalAlignment="Center"/>
                                    <TextBlock Text="horizontal datums in"
                                               FontSize="10" Foreground="#FF8888AA"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="elevation / section views"
                                               FontSize="10" Foreground="#FF8888AA"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="bubbles → left / right"
                                               FontSize="10" Foreground="#FF8888AA"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT -->
                            <Border Grid.Column="2" Style="{StaticResource SideBox}">
                                <StackPanel>
                                    <TextBlock Text="RIGHT" FontWeight="Bold" Foreground="#FFC8C8E8"
                                               HorizontalAlignment="Center"/>
                                    <CheckBox x:Name="UI_chk_right_dim" Content="Dimension"/>
                                    <CheckBox x:Name="UI_chk_right_bubble" Content="Bubble on" IsChecked="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Margin="12,0,12,12">
                            <CheckBox x:Name="UI_chk_overall" Content="Add an overall dimension string (lowest level to highest)"
                                      IsChecked="True"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="Offset from levels (mm on paper)"/>
                                    <TextBox x:Name="UI_txt_offset" Text="8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Gap between strings (mm on paper)"/>
                                    <TextBox x:Name="UI_txt_gap" Text="8"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Extent -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Border Background="#FF0E0E1A" CornerRadius="10,10,0,0">
                            <TextBlock Text="Level extent / visibility" Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <StackPanel Margin="12,8,12,10" Orientation="Horizontal">
                            <RadioButton x:Name="UI_rb_3d" Content="3D (model extent)" IsChecked="True" GroupName="Extent"/>
                            <RadioButton x:Name="UI_rb_2d" Content="2D (view specific)" GroupName="Extent"/>
                            <RadioButton x:Name="UI_rb_keep" Content="Don't change" GroupName="Extent"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Border>
</Window>
