<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Levels Dimensions" Height="650" Width="700" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#FFC8C8E8" FontFamily="Segoe UI" FontSize="12"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <SolidColorBrush x:Key="panel_bg"    Color="#FF0E0E1A"/>
        <SolidColorBrush x:Key="border_soft" Color="#FF1976D2"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource panel_bg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource border_soft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1A1A2A"/>
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="BorderBrush" Value="#FF1976D2"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="checkBoxBorder" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,2,0" Background="#FF0E0E1A" BorderBrush="#FF1976D2" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                <TextBlock x:Name="checkMark" Text="✓" Foreground="White" FontSize="10" FontWeight="Bold" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="checkBoxBorder" Property="Background" Value="#FF1976D2"/><Setter TargetName="checkMark" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#FF2196F3"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="checkBoxBorder" Property="Opacity" Value="0.45"/><Setter Property="Foreground" Value="#FF8888AA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FF0E0E1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#FF0E0E1A"/>
            <Setter Property="AlternatingRowBackground" Value="#FF131326"/>
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FF22223A"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowHeight" Value="28"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FF0E0E1A"/>
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="BorderBrush" Value="#FF22223A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FF22223A"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF1A1A2A"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF1A1A2A"/>
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

                <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF0E0E1A"/>
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#FF22223A"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#FF1976D2"/><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF8888AA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="32,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="#FF1A1A2A"/>
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource border_soft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
    <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFC8C8E8"/>
            <Setter Property="Background" Value="#FF0E0E1A"/>
        </Style>
    </Window.Resources>

    <Border Background="#FF0A0A12" BorderBrush="#FF1976D2" BorderThickness="1" CornerRadius="12" Padding="10">
    <DockPanel Margin="0">
        <Border DockPanel.Dock="Top" Background="#FF0A0A12" BorderBrush="#FF1976D2" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Width="36" Height="36" Background="#FF1976D2" CornerRadius="7" MouseLeftButtonDown="UIe_drag_window">
                    <TextBlock Text="BA" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="LEVELS DIMENSIONS" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" MouseLeftButtonDown="UIe_drag_window"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Close" IsCancel="True" MinWidth="64" Padding="12,6" Background="#FF1A1A2A" Foreground="#FFA0A0C0" BorderBrush="#FF1976D2" BorderThickness="1" Cursor="Hand"/>
                <TextBlock Text="Step 1 of 2 — choose elevation / section views" Grid.Row="1" Grid.ColumnSpan="3" Foreground="#FFFFCDA2" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource SectionCard}" Margin="0,12,0,0" Padding="14,12">
            <Button Content="Continue  →" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center" Click="UIe_btn_continue"/>
        </Border>

        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <Border Background="#FF0E0E1A" CornerRadius="10,10,0,0">
                    <TextBlock Text="Apply to (elevation / section views)" Style="{StaticResource SectionTitle}"/>
                </Border>
                <StackPanel Margin="12,10,12,10">
                    <RadioButton x:Name="UI_rb_current" Content="Current view" IsChecked="True"
                                 GroupName="Scope" Checked="UIe_scope_changed"/>
                    <TextBlock x:Name="UI_txt_current" Foreground="#FF8888AA" FontSize="11"
                               Margin="22,0,0,6"/>
                    <RadioButton x:Name="UI_rb_multi" Content="Selected views (pick from list below)"
                                 GroupName="Scope" Checked="UIe_scope_changed"/>

                    <DockPanel Margin="0,8,0,4">
                        <Button Content="Select All" Style="{StaticResource SmallButton}"
                                DockPanel.Dock="Left" Click="UIe_select_all"/>
                        <Button Content="Clear" Style="{StaticResource SmallButton}"
                                DockPanel.Dock="Left" Click="UIe_select_none"/>
                        <TextBlock x:Name="UI_txt_count" Foreground="#FF8888AA" FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>
                    <DataGrid x:Name="UI_dg_views" Height="270" IsEnabled="False" PreviewMouseLeftButtonDown="UIe_view_row_click">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="36"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="View name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding ViewTypeLabel}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</Border>
</Window>
