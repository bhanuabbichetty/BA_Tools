<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="600" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ── Slim Scrollbar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── Primary Button (Blue) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Button (Dark outline) ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button ("Close" text, blue outline) ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════
         OUTER SHELL — full dark, no OS chrome, rounded
    ════════════════════════════════════════════════════════ -->
    <Border Background="#0A0A12"
            CornerRadius="12"
            BorderBrush="#0A0A12"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 ROW 0 — TITLE BAR (drag to move)
            ══════════════════════════════════════════════ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 42 x 42 Logo badge -->
                    <Border Grid.Column="0"
                            Background="#1976D2"
                            CornerRadius="8"
                            Width="42" Height="42"
                            VerticalAlignment="Center">
                        <TextBlock Text="BA"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Heading FontSize=18 -->
                    <TextBlock Grid.Column="1"
                               Text="GRID ANNOTATION MANAGER"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <!-- Close button -->
                    <Button x:Name="btnClose"
                            Grid.Column="2"
                            Content="Close"
                            Style="{StaticResource CloseButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 1 — SUBTITLE
            ══════════════════════════════════════════════ -->
            <TextBlock Grid.Row="1"
                       Text="Add grid bubble annotations and dimensions to Floor/Structural Plans"
                       FontSize="10"
                       FontFamily="Segoe UI"
                       Foreground="#FFCDA2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- ══════════════════════════════════════════
                 ROW 2 — SCROLLABLE MAIN CONTENT
            ══════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Margin="16,8,16,0"
                          Padding="0,0,4,0">
                <StackPanel>

                    <!-- ── GRID BUBBLE ANNOTATION CARD ─────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="GRID BUBBLE ANNOTATION"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>

                            <!-- Vertical Grids -->
                            <TextBlock Text="Vertical Grids"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       FontWeight="SemiBold"
                                       Foreground="#C0C0E0"
                                       Margin="0,0,0,8"/>
                            <Grid Margin="12,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkVerticalTop"
                                          Grid.Column="0"
                                          Content="Top"
                                          Foreground="#C8C8E8"
                                          FontFamily="Segoe UI"
                                          FontSize="12"
                                          Margin="0,0,0,0"/>
                                <CheckBox x:Name="chkVerticalBottom"
                                          Grid.Column="1"
                                          Content="Bottom"
                                          Foreground="#C8C8E8"
                                          FontFamily="Segoe UI"
                                          FontSize="12"
                                          Margin="0,0,0,0"/>
                            </Grid>

                            <!-- Horizontal Grids -->
                            <TextBlock Text="Horizontal Grids"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       FontWeight="SemiBold"
                                       Foreground="#C0C0E0"
                                       Margin="0,0,0,8"/>
                            <Grid Margin="12,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkHorizontalLeft"
                                          Grid.Column="0"
                                          Content="Left"
                                          Foreground="#C8C8E8"
                                          FontFamily="Segoe UI"
                                          FontSize="12"
                                          Margin="0,0,0,0"/>
                                <CheckBox x:Name="chkHorizontalRight"
                                          Grid.Column="1"
                                          Content="Right"
                                          Foreground="#C8C8E8"
                                          FontFamily="Segoe UI"
                                          FontSize="12"
                                          Margin="0,0,0,0"/>
                            </Grid>

                            <!-- Inclined Grids -->
                            <TextBlock Text="Inclined Grids"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       FontWeight="SemiBold"
                                       Foreground="#C0C0E0"
                                       Margin="0,0,0,8"/>
                            <Grid Margin="12,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkInclinedTop"
                                          Grid.Column="0"
                                          Content="Top (Max Y)"
                                          Foreground="#C8C8E8"
                                          FontFamily="Segoe UI"
                                          FontSize="12"
                                          Margin="0,0,0,0"/>
                                <CheckBox x:Name="chkInclinedBottom"
                                          Grid.Column="1"
                                          Content="Bottom (Min Y)"
                                          Foreground="#C8C8E8"
                                          FontFamily="Segoe UI"
                                          FontSize="12"
                                          Margin="0,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Note: For inclined grids, Top is Maximum Y-value, Bottom is Minimum Y-value"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       Foreground="#FFCDA2"
                                       Margin="12,0,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── DIMENSION OPTIONS CARD ────────────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DIMENSION OPTIONS"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>

                            <CheckBox x:Name="chkIncludeDimensions"
                                      Content="Include Grid-to-Grid Dimensions"
                                      IsChecked="True"
                                      Foreground="#C8C8E8"
                                      FontFamily="Segoe UI"
                                      FontSize="12"
                                      Margin="0,0,0,4"/>
                            <TextBlock Text="Creates dimension strings with all grid spacings at 10 ft offset"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       Foreground="#FFCDA2"
                                       Margin="28,0,0,12"
                                       TextWrapping="Wrap"/>

                            <CheckBox x:Name="chkEndToEndDimensions"
                                      Content="Include End-to-End Dimensions"
                                      Foreground="#C8C8E8"
                                      FontFamily="Segoe UI"
                                      FontSize="12"
                                      Margin="0,0,0,4"/>
                            <TextBlock Text="Creates section dimensions (first to last grid only) at 20 ft offset"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       Foreground="#FFCDA2"
                                       Margin="28,0,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── TARGET VIEWS CARD ─────────────────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="TARGET VIEWS"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>

                            <CheckBox x:Name="chkAllPlanViews"
                                      Content="All Floor Plan Views"
                                      IsChecked="True"
                                      Foreground="#C8C8E8"
                                      FontFamily="Segoe UI"
                                      FontSize="12"
                                      Margin="0,0,0,8"/>

                            <CheckBox x:Name="chkAllStructuralPlanViews"
                                      Content="All Structural Plan Views"
                                      IsChecked="True"
                                      Foreground="#C8C8E8"
                                      FontFamily="Segoe UI"
                                      FontSize="12"
                                      Margin="0,0,0,8"/>

                            <CheckBox x:Name="chkActiveViewOnly"
                                      Content="Active View Only"
                                      Foreground="#C8C8E8"
                                      FontFamily="Segoe UI"
                                      FontSize="12"
                                      Margin="0,0,0,8"/>

                            <TextBlock Text="Select which view types to process (Floor Plans and Structural Plans only)"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       Foreground="#FFCDA2"
                                       Margin="28,0,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════
                 ROW 3 — FOOTER
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status -->
                    <TextBlock x:Name="txtStatus"
                               Grid.Column="0"
                               Text="Configure options and click ANNOTATE"
                               Foreground="#1976D2"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Annotate button -->
                    <Button x:Name="btnAnnotateAll"
                            Grid.Column="1"
                            Content="ANNOTATE"
                            Style="{StaticResource PrimaryButton}"
                            Width="140" Height="36"
                            IsEnabled="True"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
