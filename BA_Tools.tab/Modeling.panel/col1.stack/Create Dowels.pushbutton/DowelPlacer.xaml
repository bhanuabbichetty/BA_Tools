<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#1976D2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0C0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Section Label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Window.Resources>

    <!-- OUTER SHELL -->
    <Border Background="#0A0A12" CornerRadius="12" BorderBrush="#0A0A12" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══ ROW 0 — TITLE BAR ══ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1976D2" CornerRadius="8"
                            Width="42" Height="42" VerticalAlignment="Center">
                        <TextBlock Text="BA" FontSize="20" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="DOWEL PLACER"
                                   FontSize="18" FontWeight="Bold" Foreground="White"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Button x:Name="btnClose" Grid.Column="2" Content="Close"
                            Style="{StaticResource CloseButton}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══ ROW 1 — SUBTITLE ══ -->
            <TextBlock Grid.Row="1"
                       Text="Place dowels on a wall face with configurable offsets and spacing"
                       FontSize="11" FontFamily="Segoe UI" Foreground="#FFCDA2"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- ══ ROW 2 — MAIN CONTENT ══ -->
            <Grid Grid.Row="2" Margin="16,10,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- ── COLUMN 0: Family Selection ── -->
                <Border Grid.Column="0"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="FAMILY SELECTION" Style="{StaticResource SectionLabel}"/>

                        <!-- Family search filter -->
                        <TextBlock Text="Search Family:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFamilySearch"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="32" Margin="0,0,0,10"/>

                        <!-- Family list -->
                        <TextBlock Text="Family:" Style="{StaticResource FieldLabel}"/>
                        <Border Background="#0A0A12"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Height="160"
                                Margin="0,0,0,12">
                            <ListBox x:Name="lstFamilies"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#C8C8E8"
                                     FontFamily="Segoe UI"
                                     FontSize="12"
                                     Padding="4">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="Foreground" Value="#C8C8E8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A2A3A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>

                        <!-- Type selection -->
                        <TextBlock Text="Type:" Style="{StaticResource FieldLabel}"/>
                        <Border Background="#0A0A12"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Height="120">
                            <ListBox x:Name="lstTypes"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#C8C8E8"
                                     FontFamily="Segoe UI"
                                     FontSize="12"
                                     Padding="4">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="Foreground" Value="#C8C8E8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A2A3A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── COLUMN 2: Placement Parameters ── -->
                <Border Grid.Column="2"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="PLACEMENT PARAMETERS" Style="{StaticResource SectionLabel}"/>

                        <!-- Diagram -->
                        <Border Background="#0A0A12"
                                BorderBrush="#252545"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Wall Face Layout"
                                           Foreground="#606080"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,0,6"/>
                                <TextBlock FontFamily="Consolas" FontSize="10"
                                           Foreground="#404060"
                                           TextAlignment="Center">
                                    <Run Text="┌─────────────────────────────────┐" Foreground="#303055"/>
                                    <LineBreak/>
                                    <Run Text="│" Foreground="#303055"/>
                                    <Run Text="◄─Left─►" Foreground="#FFCDA2"/>
                                    <Run Text=" ● " Foreground="#64B5F6"/>
                                    <Run Text="←Space→" Foreground="#A0A0C0"/>
                                    <Run Text=" ● " Foreground="#64B5F6"/>
                                    <Run Text="←Space→" Foreground="#A0A0C0"/>
                                    <Run Text=" ● " Foreground="#64B5F6"/>
                                    <Run Text="◄─Right─►" Foreground="#FFCDA2"/>
                                    <Run Text="│" Foreground="#303055"/>
                                    <LineBreak/>
                                    <Run Text="└─────────────────────────────────┘" Foreground="#303055"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Left Offset -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Foreground="#FFCDA2">◄</Run>
                                    <Run Text=" Left Offset (mm)"/>
                                </TextBlock>
                                <TextBox x:Name="txtLeftOffset"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="34" Text="150"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="Right Offset (mm) "/>
                                    <Run Foreground="#FFCDA2">►</Run>
                                </TextBlock>
                                <TextBox x:Name="txtRightOffset"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="34" Text="150"/>
                            </StackPanel>
                        </Grid>

                        <!-- Spacing -->
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Foreground="#64B5F6">⟷</Run>
                            <Run Text=" Spacing / Interval (mm)"/>
                        </TextBlock>
                        <TextBox x:Name="txtSpacing"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="34" Text="300"
                                 Margin="0,0,0,10"/>

                        <!-- Elevation from Level -->
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Foreground="#81C784">↑</Run>
                            <Run Text=" Elevation from Level (mm)"/>
                        </TextBlock>
                        <TextBox x:Name="txtVerticalOffset"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="34" Text="100"
                                 Margin="0,0,0,10"/>

                        <!-- Rotation offset -->
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Foreground="#CE93D8">↻</Run>
                            <Run Text=" Rotation Offset (degrees)"/>
                        </TextBlock>
                        <TextBox x:Name="txtRotation"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="34" Text="0"
                                 Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── COLUMN 4: Info + Preview ── -->
                <Border Grid.Column="4"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="14,14">
                    <StackPanel>
                        <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}"/>

                        <!-- Selected family display -->
                        <Border Background="#0A0A12"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Selected Family"
                                           Foreground="#606080"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtSelectedFamily"
                                           Text="— none —"
                                           Foreground="#64B5F6"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtSelectedType"
                                           Text=""
                                           Foreground="#A0A0C0"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Calculated count display -->
                        <Border Background="#0A0A12"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Estimated Count"
                                           Foreground="#606080"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtEstimatedCount"
                                           Text="Pick a face to preview"
                                           Foreground="#81C784"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- How it works -->
                        <Border Background="#0A0A12"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Padding="10,10">
                            <StackPanel>
                                <TextBlock Text="ℹ  How it works"
                                           Foreground="#1976D2"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           Margin="0,0,0,8"/>
                                <TextBlock Foreground="#808090" FontFamily="Segoe UI"
                                           FontSize="11" TextWrapping="Wrap" LineHeight="14">
                                    <Run Foreground="#FFCDA2" FontWeight="Bold">1.</Run>
                                    <Run> Select family &amp; type</Run>
                                    <LineBreak/>
                                    <Run Foreground="#FFCDA2" FontWeight="Bold">2.</Run>
                                    <Run> Set left / right offsets</Run>
                                    <LineBreak/>
                                    <Run Foreground="#FFCDA2" FontWeight="Bold">3.</Run>
                                    <Run> Set spacing interval</Run>
                                    <LineBreak/>
                                    <Run Foreground="#FFCDA2" FontWeight="Bold">4.</Run>
                                    <Run> Set height from bottom</Run>
                                    <LineBreak/>
                                    <Run Foreground="#FFCDA2" FontWeight="Bold">5.</Run>
                                    <Run> Click PICK FACE</Run>
                                    <LineBreak/>
                                    <Run Foreground="#FFCDA2" FontWeight="Bold">6.</Run>
                                    <Run> Click on a wall face</Run>
                                    <LineBreak/><LineBreak/>
                                    <Run Foreground="#606080">Dowels placed from</Run>
                                    <LineBreak/>
                                    <Run Foreground="#FFCDA2">Left Offset</Run>
                                    <Run Foreground="#606080"> to </Run>
                                    <Run Foreground="#FFCDA2">Right Offset</Run>
                                    <LineBreak/>
                                    <Run Foreground="#606080">at every </Run>
                                    <Run Foreground="#64B5F6">Spacing</Run>
                                    <Run Foreground="#606080"> interval.</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── COLUMN 6: Model Properties ── -->
                <Border Grid.Column="6"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="14,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="MODEL PROPERTIES" Style="{StaticResource SectionLabel}"/>
                            
                            <!-- Dowel Offset -->
                            <TextBlock Text="Dowel Offset (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtDowelOffset"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34" Text="100.0"
                                     Margin="0,0,0,10"/>
                            
                            <!-- Gap @ Top -->
                            <TextBlock Text="Gap @ Top (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtGapTop"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34" Text="100.0"
                                     Margin="0,0,0,10"/>
                            
                            <!-- C/P Joint Distance -->
                            <TextBlock Text="C/P Joint Distance (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtCPJointDistance"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34" Text="150.0"
                                     Margin="0,0,0,10"/>
                            
                            <!-- Embedded Bar Depth -->
                            <TextBlock Text="Embedded Bar Depth (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtEmbeddedBarDepth"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34" Text="800.0"
                                     Margin="0,0,0,10"/>
                            
                            <!-- Embedded Bar Depth (X-Dir) -->
                            <TextBlock Text="Embedded Depth X-Dir (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtEmbeddedDepthX"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34" Text="500.0"
                                     Margin="0,0,0,10"/>
                            
                            <!-- Embedded Bar Depth (Y-Dir) -->
                            <TextBlock Text="Embedded Depth Y-Dir (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtEmbeddedDepthY"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34" Text="300.0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>

            <!-- ══ ROW 3 — FOOTER ══ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtStatus"
                               Grid.Column="0"
                               Text="Select a family type, configure parameters, then pick a wall face"
                               Foreground="#1976D2"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="btnCancel"
                            Grid.Column="1"
                            Content="CANCEL"
                            Style="{StaticResource SecondaryButton}"
                            Width="100" Height="36"/>

                    <Button x:Name="btnPickFace"
                            Grid.Column="3"
                            Content="▶  PICK FACE &amp; PLACE"
                            Style="{StaticResource PrimaryButton}"
                            Width="210" Height="36"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
