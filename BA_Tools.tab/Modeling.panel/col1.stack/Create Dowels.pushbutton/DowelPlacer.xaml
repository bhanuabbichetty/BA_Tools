<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="1050" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ══ SCROLLBAR — Blue rounded ══ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="#0A0A18" CornerRadius="3"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#1976D2" CornerRadius="3"
                                                                    Margin="1,2"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ══ COMBOBOX — dark themed ══ -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0A0A14"/>
            <Setter Property="Foreground" Value="#E0E0FF"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <Border Grid.Column="1"
                                            BorderBrush="#1976D2" BorderThickness="1,0,0,0"
                                            Background="Transparent">
                                        <TextBlock Text="▾" Foreground="#1976D2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </Border>
                                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220"
                                        Background="#0E0E1E"
                                        BorderBrush="#1976D2"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="bd" Property="Background" Value="#0D0D1E"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="bd" Property="Background" Value="#0D0D1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#C8C8E8"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="itemBd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="4"
                                        Margin="3,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="itemBd" Property="Background" Value="#1A2A40"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="itemBd" Property="Background" Value="#1976D2"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C62828"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#EF5350"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#1976D2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Section Label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Visibility Toggle — OFF -->
        <Style x:Key="VisToggleOff" TargetType="Button">
            <Setter Property="Background" Value="#111120"/>
            <Setter Property="Foreground" Value="#FFCDA2"/>
            <Setter Property="BorderBrush" Value="#252545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2030"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1976D2"/>
                                <Setter Property="Foreground" Value="#C0C0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Visibility Toggle — ON -->
        <Style x:Key="VisToggleOn" TargetType="Button">
            <Setter Property="Background" Value="#0D3060"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- OUTER SHELL -->
    <Border Background="#0A0A12" CornerRadius="10" BorderBrush="#0A0A12" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- ══ TITLE BAR ══ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="10,10,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1976D2" CornerRadius="8"
                            Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="BA" FontSize="17" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="DOWEL PLACER"
                                   FontSize="16" FontWeight="Bold" Foreground="White"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Button x:Name="btnClose" Grid.Column="2" Content="✕  Close"
                            Style="{StaticResource CloseButton}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══ SUBTITLE ══ -->
            <TextBlock Grid.Row="1"
                       Text="Place dowels on a wall face with configurable offsets and spacing"
                       FontSize="11" FontFamily="Segoe UI" Foreground="#FFCDA2"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- ══ MAIN CONTENT ══ -->
            <Grid Grid.Row="2" Margin="14,10,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ══ COL 0 — FAMILY SELECTION ══ -->
                <Border Grid.Column="0"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="FAMILY SELECTION" Style="{StaticResource SectionLabel}"/>

                        <!-- Family dropdown -->
                        <TextBlock Text="Family:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbFamilies"
                                  Style="{StaticResource DarkComboBox}"
                                  Margin="0,0,0,12"/>

                        <!-- Type dropdown -->
                        <TextBlock Text="Type:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbTypes"
                                  Style="{StaticResource DarkComboBox}"
                                  Margin="0,0,0,16"/>

                        <!-- Selected info card -->
                        <Border Background="#0A0A14"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Padding="10,9"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Selected"
                                           Foreground="#505070"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtSelectedFamily"
                                           Text="— none —"
                                           Foreground="#64B5F6"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtSelectedType"
                                           Text=""
                                           Foreground="#9090B8"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Estimated count card -->
                        <Border Background="#0A0A14"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Padding="10,9">
                            <StackPanel>
                                <TextBlock Text="Estimated Count"
                                           Foreground="#505070"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtEstimatedCount"
                                           Text="Pick a face to preview"
                                           Foreground="#81C784"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ══ COL 2 — PLACEMENT PARAMETERS ══ -->
                <Border Grid.Column="2"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="PLACEMENT PARAMETERS" Style="{StaticResource SectionLabel}"/>

                        <!-- Wall diagram -->
                        <Border Background="#0A0A12"
                                BorderBrush="#252545"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Wall Face Layout"
                                           Foreground="#505070"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <TextBlock FontFamily="Consolas" FontSize="10"
                                           Foreground="#404060"
                                           TextAlignment="Center">
                                    <Run Text="┌──────────────────────────────────┐" Foreground="#303055"/>
                                    <LineBreak/>
                                    <Run Text="│" Foreground="#303055"/>
                                    <Run Text="◄Left►" Foreground="#FFCDA2"/>
                                    <Run Text=" ● " Foreground="#64B5F6"/>
                                    <Run Text="←Space→" Foreground="#A0A0C0"/>
                                    <Run Text=" ● " Foreground="#64B5F6"/>
                                    <Run Text="←Space→" Foreground="#A0A0C0"/>
                                    <Run Text=" ● " Foreground="#64B5F6"/>
                                    <Run Text="◄Right►" Foreground="#FFCDA2"/>
                                    <Run Text="│" Foreground="#303055"/>
                                    <LineBreak/>
                                    <Run Text="└──────────────────────────────────┘" Foreground="#303055"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Left + Right offset -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Foreground="#FFCDA2">◄</Run>
                                    <Run Text=" Left Offset (mm)"/>
                                </TextBlock>
                                <TextBox x:Name="txtLeftOffset"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="32" Text="250"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="Right Offset (mm) "/>
                                    <Run Foreground="#FFCDA2">►</Run>
                                </TextBlock>
                                <TextBox x:Name="txtRightOffset"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="32" Text="250"/>
                            </StackPanel>
                        </Grid>

                        <!-- Spacing + Elevation -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Foreground="#64B5F6">⟷</Run>
                                    <Run Text=" Spacing / Interval (mm)"/>
                                </TextBlock>
                                <TextBox x:Name="txtSpacing"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="32" Text="1000"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Foreground="#81C784">↑</Run>
                                    <Run Text=" Elevation from Level (mm)"/>
                                </TextBlock>
                                <TextBox x:Name="txtVerticalOffset"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="32" Text="16"/>
                            </StackPanel>
                        </Grid>

                        <!-- Rotation -->
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Foreground="#CE93D8">↻</Run>
                            <Run Text=" Rotation Offset (degrees)"/>
                        </TextBlock>
                        <TextBox x:Name="txtRotation"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="32" Text="0"/>
                    </StackPanel>
                </Border>

                <!-- ══ COL 4 — MODEL PROPERTIES + VISIBILITY ══ -->
                <Border Grid.Column="4"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="14,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="MODEL PROPERTIES" Style="{StaticResource SectionLabel}"/>

                            <!-- Dowel Offset + Gap @ Top -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Dowel Offset (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtDowelOffset"
                                             Style="{StaticResource DarkTextBox}"
                                             Height="30" Text="80"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Gap @ Top (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtGapTop"
                                             Style="{StaticResource DarkTextBox}"
                                             Height="30" Text="20"/>
                                </StackPanel>
                            </Grid>

                            <!-- C/P Joint Distance -->
                            <TextBlock Text="C/P Joint Distance (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtCPJointDistance"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="30" Text="16"
                                     Margin="0,0,0,8"/>

                            <!-- Embedded Bar Depth -->
                            <TextBlock Text="Embedded Bar Depth (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtEmbeddedBarDepth"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="30" Text="800.0"
                                     Margin="0,0,0,8"/>

                            <!-- Emb X + Y -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Emb. Depth X (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtEmbeddedDepthX"
                                             Style="{StaticResource DarkTextBox}"
                                             Height="30" Text="500.0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Emb. Depth Y (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtEmbeddedDepthY"
                                             Style="{StaticResource DarkTextBox}"
                                             Height="30" Text="300.0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Separator -->
                            <Border BorderBrush="#1976D2" BorderThickness="0,0.6,0,0" Margin="0,0,0,12"/>

                            <!-- VISIBILITY -->
                            <TextBlock Text="VISIBILITY" Style="{StaticResource SectionLabel}"/>

                            <TextBlock Text="Click a position to activate — click again to deselect."
                                       Foreground="#505070"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <!-- A + B -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnPosA" Grid.Column="0"
                                        Content="Position A"
                                        Style="{StaticResource VisToggleOff}"
                                        Tag="A"/>
                                <Button x:Name="btnPosB" Grid.Column="2"
                                        Content="Position B"
                                        Style="{StaticResource VisToggleOff}"
                                        Tag="B"/>
                            </Grid>

                            <!-- C + D -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnPosC" Grid.Column="0"
                                        Content="Position C"
                                        Style="{StaticResource VisToggleOff}"
                                        Tag="C"/>
                                <Button x:Name="btnPosD" Grid.Column="2"
                                        Content="Position D"
                                        Style="{StaticResource VisToggleOff}"
                                        Tag="D"/>
                            </Grid>

                            <!-- Active indicator -->
                            <Border Background="#0A0A14"
                                    BorderBrush="#1976D2"
                                    BorderThickness="0.8"
                                    CornerRadius="6"
                                    Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Active: "
                                               Foreground="#505070"
                                               FontFamily="Segoe UI"
                                               FontSize="11"/>
                                    <TextBlock x:Name="txtActivePosition"
                                               Text="None"
                                               Foreground="#64B5F6"
                                               FontFamily="Segoe UI"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>

            <!-- ══ FOOTER ══ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    CornerRadius="0,0,10,10"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtStatus"
                               Grid.Column="0"
                               Text="Select a family and type, configure parameters, then pick a wall face"
                               Foreground="#1976D2"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="btnCancel"
                            Grid.Column="1"
                            Content="CANCEL"
                            Style="{StaticResource SecondaryButton}"
                            Width="95" Height="34"/>

                    <Button x:Name="btnPickFace"
                            Grid.Column="3"
                            Content="▶  PICK FACE &amp; PLACE"
                            Style="{StaticResource PrimaryButton}"
                            Width="200" Height="34"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
