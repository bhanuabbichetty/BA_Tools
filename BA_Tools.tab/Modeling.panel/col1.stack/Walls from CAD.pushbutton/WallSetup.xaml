<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BA Tools | Walls from CAD" Width="1200" Height="780" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="Transparent" FontFamily="Segoe UI" FontSize="12" Foreground="#DCDCEC"><Window.Resources>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#B0B0C0"/></Style>
 <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#B0B0C0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="FontSize" Value="11"/></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#0A0A14"/><Setter Property="Padding" Value="9,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#163961"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#173252"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="Background" Value="#0A0A14"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1976D2"/><Setter Property="Height" Value="32"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#0A0A14" BorderBrush="#1976D2" BorderThickness="0.8" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Border Grid.Column="1" BorderBrush="#1976D2" BorderThickness="0.8,0,0,0"><Path Data="M 0 0 L 7 0 L 3.5 4 Z" Fill="#9CB4D4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="9,0,34,0" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#0A0A14" BorderBrush="#1976D2" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#101018"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3B4560"/><Setter Property="Padding" Value="8,5"/><Setter Property="Height" Value="32"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCDCEC"/><Setter Property="Margin" Value="5,5"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#252535"/><Setter Property="Foreground" Value="#AFC7E8"/><Setter Property="Padding" Value="10,9"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#35435C"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="#E0E0F0"/></Style>
 <Style TargetType="DataGridRow"><Setter Property="Background" Value="#191923"/><Setter Property="Foreground" Value="#E0E0F0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#242C3C"/></Trigger></Style.Triggers></Style>
</Window.Resources>
<Border Background="#0A0A12" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
<Border x:Name="HeaderDrag" Background="#0E0E1A" CornerRadius="12,12,0,0" BorderBrush="#1976D2" BorderThickness="0,0,0,1"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="6" Background="#1976D2" HorizontalAlignment="Left"><TextBlock Text="BA" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="WALLS FROM CAD" FontSize="15" FontWeight="Bold" Foreground="White"/><TextBlock Text="Automatic wall types / multiple CAD layers" FontSize="10" Foreground="#727A92" Margin="0,3,0,0"/></StackPanel><Button x:Name="CloseTop" Grid.Column="2" Content="Close" Style="{DynamicResource CloseButton}"/></Grid></Border>
<Grid Grid.Row="1" Margin="16,16,16,10"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#0E0E1A" BorderBrush="#1976D2" BorderThickness="0.8" CornerRadius="7" Padding="16"><StackPanel><TextBlock Text="SOURCE &amp; COMMON SETTINGS" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,18"/>
<TextBlock Text="Linked CAD file" Style="{StaticResource Label}"/><ComboBox x:Name="Sources"/><TextBlock Text="READ CAD detects wall layers and their thicknesses from the saved DWG." FontSize="10" Foreground="#727A92" TextWrapping="Wrap" Margin="0,7,0,16"/>
<TextBlock Text="Base level" Style="{StaticResource Label}"/><ComboBox x:Name="BaseLevel" Margin="0,0,0,12"/><TextBlock Text="Base offset (mm) / fixed" Style="{StaticResource Label}"/><TextBox Text="16" IsReadOnly="True" IsTabStop="False" Foreground="#59BAFF" Margin="0,0,0,14"/>
<TextBlock Text="Top level" Style="{StaticResource Label}"/><ComboBox x:Name="TopLevel"/><TextBlock Text="Set a separate top offset for each layer in the table." FontSize="10" Foreground="#727A92" TextWrapping="Wrap" Margin="0,7,0,16"/>
<CheckBox x:Name="Unjoin" Content="Disallow joins at both ends" IsChecked="True"/><CheckBox x:Name="CreateTypes" Content="Create missing wall types" IsChecked="True"/><TextBlock Text="New types copy a single-layer basic wall and use the layer thickness. Existing types stay unchanged." FontSize="10" Foreground="#727A92" TextWrapping="Wrap" Margin="4,7,0,14"/>
<TextBlock Text="Keyway gap to fill (mm)" Style="{StaticResource Label}"/><TextBox x:Name="Keyway" Text="80"/><TextBlock Text="0 keeps all gaps. Larger openings remain clear." FontSize="10" Foreground="#727A92" TextWrapping="Wrap" Margin="0,7,0,0"/>
</StackPanel></Border>
<Border Grid.Column="2" Background="#0E0E1A" BorderBrush="#1976D2" BorderThickness="0.8" CornerRadius="7" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="LAYER / WALL TYPE PLAN" Foreground="White" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Select layers to include. Edit each top offset in millimetres; negative values lower the wall top." Foreground="#9FB4D4" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,12"/>
<DataGrid x:Name="Mapping" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#252535" Background="#0A0A14" BorderBrush="#252F48"><DataGrid.Columns>
<DataGridCheckBoxColumn Header="Use" Binding="{Binding Use,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="40"/>
<DataGridTextColumn Header="CAD layer" Binding="{Binding Layer}" IsReadOnly="True" Width="190"/>
<DataGridTextColumn Header="mm" Binding="{Binding Width}" IsReadOnly="True" Width="45"/>
<DataGridTextColumn Header="Automatic wall type" Binding="{Binding Type}" IsReadOnly="True" Width="190"/>
<DataGridTextColumn Header="Top offset" Binding="{Binding TopOffset,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="80"/>
<DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="160"/>
</DataGrid.Columns></DataGrid>
<TextBlock x:Name="Summary" Grid.Row="3" Text="Read the CAD drawing to build the layer plan." Foreground="#9FB4D4" FontSize="11" Margin="0,14,0,10" TextWrapping="Wrap"/>
<DataGrid x:Name="Preview" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#252535" Background="#0A0A14" BorderBrush="#252F48"><DataGrid.Columns><DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="260"/><DataGridTextColumn Header="Length (mm)" Binding="{Binding Length}" Width="105"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170"/><DataGridTextColumn Header="Face rule" Binding="{Binding Face}" Width="140"/></DataGrid.Columns></DataGrid>
<TextBlock x:Name="Status" Grid.Row="5" Text="Ready. Read the saved CAD drawing." Foreground="#59BAFF" TextWrapping="Wrap" Margin="0,12,0,0"/>
</Grid></Border></Grid>
<Border Grid.Row="2" Background="#0E0E1A" BorderBrush="#1976D2" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="BA TOOLS / AUTOMATION" Foreground="#606077" FontSize="10" VerticalAlignment="Center"/><Button x:Name="Read" Grid.Column="1" Content="READ CAD" Width="132" Height="36" Style="{DynamicResource SecondaryButton}"/><Button x:Name="Create" Grid.Column="3" Content="CREATE WALLS" Width="158" Height="36" IsEnabled="False" Style="{DynamicResource PrimaryButton}"/></Grid></Border>
</Grid></Border></Window>