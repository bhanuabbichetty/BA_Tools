<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Void Placer  -  BA Tools"
    Width="1100" Height="760"
    MinWidth="1000" MinHeight="700"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    ResizeMode="NoResize"
    Background="Transparent"
    Foreground="#DCDCEC"
    FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ComboBox item -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#101018"/>
            <Setter Property="Foreground" Value="#DCDCEC"/>
            <Setter Property="Padding"    Value="10,6"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#173252"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox toggle (the closed box + arrow) -->
        <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="#59BAFF"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#59BAFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Full dark ComboBox template: dark box, light text, dark drop-down list -->
        <ControlTemplate x:Key="DarkComboTemplate" TargetType="ComboBox">
            <Grid x:Name="Root">
                <ToggleButton Template="{StaticResource DarkComboToggle}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Focusable="False"
                              ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  TextElement.Foreground="#DCDCEC"
                                  Margin="10,2,32,2"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            Background="#101018"
                            BorderBrush="#1976D2"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,2,0,0">
                        <ScrollViewer SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Height"             Value="32"/>
            <Setter Property="Background"         Value="#101018"/>
            <Setter Property="Foreground"         Value="#DCDCEC"/>
            <Setter Property="BorderBrush"        Value="#35435C"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="FontSize"           Value="12"/>
            <Setter Property="Padding"            Value="8,2"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template"           Value="{StaticResource DarkComboTemplate}"/>
        </Style>

        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="Background"               Value="#101018"/>
            <Setter Property="Foreground"               Value="#DCDCEC"/>
            <Setter Property="BorderBrush"              Value="#35435C"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="10,2"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="#59BAFF"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#A0A0C0"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#0E0E1A"/>
            <Setter Property="BorderBrush"     Value="#252535"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCDCEC"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ── Selectable face-side card (RadioButton drawn as a card) ────── -->
        <Style x:Key="FaceCard" TargetType="RadioButton">
            <Setter Property="Foreground"  Value="#DCDCEC"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Margin"      Value="0,0,10,0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="#0A0A12"
                                BorderBrush="#252535"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12"
                                Width="190" Height="92">
                            <StackPanel>
                                <TextBlock x:Name="Hdr"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="#A0A0C0"
                                           Margin="0,0,0,4"/>
                                <ContentPresenter
                                    TextBlock.FontSize="14"
                                    TextBlock.FontWeight="Bold"
                                    TextBlock.Foreground="#DCDCEC"
                                    Margin="0,0,0,6"/>
                                <TextBlock x:Name="SubTxt"
                                           FontSize="10"
                                           Foreground="#727A92"
                                           TextWrapping="Wrap"
                                           Text="{TemplateBinding ToolTip}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3F4854"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#101018"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1976D2"/>
                                <Setter TargetName="Hdr" Property="Foreground" Value="#59BAFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big primary action button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#1976D2"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#252535"/>
                                <Setter Property="Foreground" Value="#727A92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet secondary button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="#252535"/>
            <Setter Property="Foreground"      Value="#DCDCEC"/>
            <Setter Property="BorderBrush"     Value="#35435C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A313A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Summary row label / value -->
        <Style x:Key="SumLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
        </Style>
        <Style x:Key="SumValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#DCDCEC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </Window.Resources>

    <Border Background="#0A0A12" CornerRadius="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- Header -->
            <RowDefinition Height="34"/>   <!-- Subtitle band -->
            <RowDefinition Height="*"/>    <!-- Body -->
            <RowDefinition Height="56"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════
             HEADER
        ══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                x:Name="HeaderDrag"
                Background="#0E0E1A"
                BorderBrush="#252535"
                BorderThickness="0,0,0,1"
                CornerRadius="12,12,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#1976D2"
                        CornerRadius="4"
                        Width="34" Height="34"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <TextBlock Text="BA"
                               FontSize="14" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="VOID PLACER"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#DCDCEC"/>
                    <TextBlock Text="BA Tools  ·  Automation Extension"
                               FontSize="10" Foreground="#727A92"/>
                </StackPanel>

                <Button Grid.Column="3"
                        x:Name="btnClose"
                        Content="Close"
                        Style="{StaticResource GhostBtn}"
                        Width="80" Height="30"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             SUBTITLE BAND
        ══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#0A0A12"
                BorderBrush="#252535"
                BorderThickness="0,0,0,1">
            <TextBlock VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       Foreground="#A0A0C0"
                       Text="Place from the selected top level downward  ·  Void length follows wall length  ·  Auto-corrects to cut into wall body"/>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             BODY
        ══════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT COLUMN ─────────────────────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Wall selection -->
                    <RowDefinition Height="*"/>      <!-- Family -->
                </Grid.RowDefinitions>

                <!-- Wall selection -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="WALL SELECTION"/>

                        <Button x:Name="btnPickWalls"
                                Style="{StaticResource PrimaryBtn}"
                                Content="▶  RE-PICK WALLS"
                                Height="36"
                                Margin="0,0,0,8"/>

                        <Border Background="#0A0A12"
                                BorderBrush="#252535"
                                BorderThickness="1"
                                CornerRadius="4"
                                Height="120">
                            <Grid>
                                <ListBox x:Name="lstWalls"
                                         Background="Transparent"
                                         Foreground="#DCDCEC"
                                         BorderThickness="0"
                                         FontSize="11"
                                         FontFamily="Consolas"
                                         IsHitTestVisible="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#DCDCEC"/>
                                            <Setter Property="Padding"    Value="10,4"/>
                                            <Setter Property="BorderBrush"     Value="#252535"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock x:Name="txtWallEmpty"
                                           Text="No walls selected"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#727A92"/>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="#101018"
                                    BorderBrush="#35435C"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,3">
                                <TextBlock x:Name="txtWallCount"
                                           Text="0 walls"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#59BAFF"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Void family -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="VOID FAMILY"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Search:"/>
                        <TextBox x:Name="txtFamSearch"
                                 Style="{StaticResource DarkInput}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Family:"/>
                        <ComboBox x:Name="cmbFamily"
                                  Style="{StaticResource DarkCombo}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Type:"/>
                        <ComboBox x:Name="cmbType"
                                  Style="{StaticResource DarkCombo}"/>

                        <TextBlock Margin="0,10,0,0"
                                   FontSize="10"
                                   Foreground="#727A92"
                                   TextWrapping="Wrap"
                                   Text="Face-based Generic Model families only.  Type dropdown updates with the family selection."/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── RIGHT COLUMN ────────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Wall face side -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="WALL FACE SIDE"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbInterior"
                                             Style="{StaticResource FaceCard}"
                                             Tag="SIDE A"
                                             Content="Interior"
                                             ToolTip="Host on inner finish face. Void cuts INTO the wall body."
                                             IsChecked="True"/>
                                <RadioButton x:Name="rbExterior"
                                             Style="{StaticResource FaceCard}"
                                             Tag="SIDE B"
                                             Content="Exterior"
                                             ToolTip="Host on outer finish face. Void cuts INTO the wall body."/>
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="10"
                                       Foreground="#727A92"
                                       TextWrapping="Wrap"
                                       Text="Whichever side you pick, the void is auto-flipped after placement so it always extrudes into the wall solid (never into the room or outside)."/>
                        </StackPanel>
                    </Border>

                    <!-- Level + dimensions -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="LEVEL  &amp;  DIMENSIONS"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Text="Top Level"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Style="{StaticResource FieldLabel}"
                                           Text="Top Offset from Level (mm)"/>

                                <ComboBox Grid.Row="1" Grid.Column="0"
                                          x:Name="cmbLevel"
                                          Style="{StaticResource DarkCombo}"/>
                                <TextBox  Grid.Row="1" Grid.Column="2"
                                          x:Name="txtElevation"
                                          Style="{StaticResource DarkInput}"
                                          Text="0"
                                          ToolTip="The void top is set at this offset; its height extends downward."/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,4"
                                           Text="Height downward (mm)"/>
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,4"
                                           Text="Length (auto)"/>

                                <TextBox Grid.Row="3" Grid.Column="0"
                                         x:Name="txtHeight"
                                         Style="{StaticResource DarkInput}"
                                         Text="310"/>
                                <TextBox Grid.Row="3" Grid.Column="2"
                                         IsReadOnly="True"
                                         Style="{StaticResource DarkInput}"
                                         Text="= wall length"
                                         Foreground="#727A92"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="OPTIONS"/>
                            <CheckBox x:Name="chkAutoCut"
                                      Style="{StaticResource DarkCheck}"
                                      IsChecked="True"
                                      Content="Auto-cut host wall with void"/>
                            <CheckBox x:Name="chkMatchWS"
                                      Style="{StaticResource DarkCheck}"
                                      IsChecked="True"
                                      Content="Match host wall workset"/>
                        </StackPanel>
                    </Border>

                    <!-- Summary -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="PLACEMENT SUMMARY"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SumLabel}" Text="Walls:"     Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtSumWalls" Style="{StaticResource SumValue}" Margin="0,0,0,6" Text="—"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource SumLabel}" Text="Face side:" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" x:Name="txtSumFace" Style="{StaticResource SumValue}" Margin="0,0,0,6" Text="—"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SumLabel}" Text="Family:"   Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtSumFamily" Style="{StaticResource SumValue}" Margin="0,0,0,6" Text="—"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource SumLabel}" Text="Level:"    Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" x:Name="txtSumLevel" Style="{StaticResource SumValue}" Margin="0,0,0,6" Text="—"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SumLabel}" Text="Height:"   Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtSumHeight" Style="{StaticResource SumValue}" Margin="0,0,0,6" Text="—"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource SumLabel}" Text="Top / base:"   Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="4" x:Name="txtSumOffset" Style="{StaticResource SumValue}" Margin="0,0,0,6" Text="—"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource SumLabel}" Text="Options:"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                                           x:Name="txtSumOptions" Style="{StaticResource SumValue}" Text="—"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             FOOTER
        ══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#0E0E1A"
                BorderBrush="#252535"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,12,12">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="#1976D2"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtStatus"
                               Foreground="#A0A0C0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Text="Pick walls to begin."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnCancel"
                            Style="{StaticResource GhostBtn}"
                            Content="CANCEL"
                            Width="100" Height="36"
                            Margin="0,0,8,0"/>
                    <Button x:Name="btnPlace"
                            Style="{StaticResource PrimaryBtn}"
                            Content="▶  PLACE VOID"
                            Width="160" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
    </Border>
</Window>
