<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sheet Generator  -  BA Tools"
    Width="900" Height="650"
    MinWidth="820" MinHeight="560"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    ResizeMode="NoResize"
    Background="Transparent"
    Foreground="#DCDCEC"
    FontFamily="Segoe UI">

    <Window.Resources>

        <!-- BA Tools palette -->
        <SolidColorBrush x:Key="accent"  Color="#1976D2"/>
        <SolidColorBrush x:Key="hover"   Color="#2196F3"/>
        <SolidColorBrush x:Key="blueTxt" Color="#59BAFF"/>
        <SolidColorBrush x:Key="peach"   Color="#F2B77C"/>
        <SolidColorBrush x:Key="muted"   Color="#A0A0C0"/>
        <SolidColorBrush x:Key="txt"     Color="#DCDCEC"/>

        <!-- Scrollbar thumb -->
        <Style x:Key="BAThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#35435C" CornerRadius="4" Width="{TemplateBinding Width}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#101018"/>
            <Setter Property="Width"      Value="10"/>
            <Setter Property="Margin"     Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource BAThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button (Close) -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="#DCDCEC"/>
            <Setter Property="Background"      Value="#101018"/>
            <Setter Property="BorderBrush"     Value="#35435C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#1E2433"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button (Generate) -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="#1976D2" Padding="20,8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox: dark box, light text, dark drop-down -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"      Value="#DCDCEC"/>
            <Setter Property="Background"      Value="#101018"/>
            <Setter Property="BorderBrush"     Value="#35435C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="#101018"
                                                BorderBrush="#35435C"
                                                BorderThickness="1" CornerRadius="4">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#59BAFF"
                                                  Width="9" Height="5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1976D2"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#59BAFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="#DCDCEC"
                                              Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#101018" BorderBrush="#1976D2"
                                        BorderThickness="1" CornerRadius="4" Margin="0,2,0,0">
                                    <ScrollViewer Focusable="False">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#101018"/>
            <Setter Property="Foreground" Value="#DCDCEC"/>
            <Setter Property="Padding"    Value="10,7"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#173252"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#101018"/>
            <Setter Property="Foreground"      Value="#DCDCEC"/>
            <Setter Property="BorderBrush"     Value="#35435C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="CaretBrush"      Value="#59BAFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════  ROOT  ═══════════════════════════ -->
    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#1976D2" Background="#0A0A12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>   <!-- Header -->
                <RowDefinition Height="34"/>   <!-- Subtitle band -->
                <RowDefinition Height="*"/>    <!-- Body -->
                <RowDefinition Height="64"/>   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#0A0A12"
                    BorderBrush="#1976D2" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseDown="UIe_header_drag">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="#1976D2" VerticalAlignment="Center">
                        <TextBlock Text="BA" Foreground="White" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="1" Text="SHEET CREATION"
                               Foreground="#F5F6FA" FontWeight="Bold" FontSize="17"
                               Margin="16,0,0,0" VerticalAlignment="Center"/>

                    <Button Grid.Column="2" Content="Close"
                            Style="{StaticResource GhostBtn}"
                            Width="80" Height="32"
                            Click="UIe_header_btn_close"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- SUBTITLE BAND -->
            <Border Grid.Row="1" Background="#0A0A12"
                    BorderBrush="#1976D2" BorderThickness="0,0,0,1">
                <TextBlock Text="Create new sheets with a selected title block  ·  Sheets only, no views placed"
                           Foreground="{StaticResource peach}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- BODY -->
            <Grid Grid.Row="2" Margin="18,14,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL -->
                <Border Grid.Column="0" CornerRadius="8" Background="#0A0A12"
                        BorderBrush="#1976D2" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="TITLE BLOCK" Foreground="#F5F6FA"
                                   FontWeight="Bold" FontSize="12" Margin="0,0,0,12"/>
                        <TextBlock Text="Choose the title block used for every new sheet."
                                   Foreground="{StaticResource muted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ComboBox x:Name="UI_combo_title_blocks" Height="34"
                                  SelectionChanged="UIe_title_block_changed"/>

                        <Border Height="1" Background="#252535" Margin="0,20,0,16"/>

                        <TextBlock Text="SHEET DETAILS" Foreground="#F5F6FA"
                                   FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                        <TextBlock Text="Add a card for each sheet. Enter its number and name, then select Generate Sheets."
                                   Foreground="{StaticResource muted}" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- RIGHT PANEL -->
                <Border Grid.Column="2" CornerRadius="8" Background="#0A0A12"
                        BorderBrush="#1976D2" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SHEETS TO CREATE" Foreground="#F5F6FA"
                                           FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="Set a number and name for each sheet"
                                           Foreground="{StaticResource peach}" FontSize="10"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="UI_txt_count" Text="1 sheet"
                                       Foreground="{StaticResource blueTxt}" FontSize="11"
                                       FontWeight="SemiBold" VerticalAlignment="Top"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,12,0,10"
                                      VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="UI_sheet_grid" Orientation="Horizontal"
                                       VerticalAlignment="Top">

                                <!-- Default first card -->
                                <Border Tag="sheet_card" CornerRadius="8"
                                        Background="#0E0E1A" BorderBrush="#252535" BorderThickness="1"
                                        Margin="0,0,10,10" MinWidth="260">
                                    <StackPanel Margin="10,8,10,10">
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock Text="Sheet Number" Width="118"
                                                       Foreground="#59BAFF" FontSize="10"/>
                                            <TextBlock Text="Sheet Name"
                                                       Foreground="#59BAFF" FontSize="10"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBox Text="A-001" Width="110" Margin="0,0,8,0"
                                                     DockPanel.Dock="Left"/>
                                            <TextBox Text="Sheet Name"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- [+] Add card tile -->
                                <Border Tag="border_add" CornerRadius="8"
                                        Background="#0E0E1A" BorderBrush="#252535" BorderThickness="1"
                                        Margin="0,0,10,10" MinWidth="80" MinHeight="80">
                                    <Grid>
                                        <Ellipse x:Name="HoverEllipse"
                                                 Fill="#1A1976D2"
                                                 Stroke="#1976D2" StrokeThickness="1"
                                                 Width="52" Height="52"
                                                 RenderTransformOrigin="0.5,0.5"
                                                 MouseDown="UIe_add_sheet_card"
                                                 Cursor="Hand">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="EllipseScaleTransform"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="EllipseScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="EllipseScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="EllipseScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="EllipseScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock Text="+" FontSize="28" FontWeight="Bold"
                                                   Foreground="#59BAFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>

                            </WrapPanel>
                        </ScrollViewer>

                        <!-- Info box -->
                        <Border Grid.Row="2" CornerRadius="6" BorderBrush="#1976D2"
                                BorderThickness="1" Background="#0A0A12" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Sheet Numbering" Foreground="#59BAFF"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Foreground="#DCDCEC" FontSize="10" TextWrapping="Wrap"
                                           Text="If a sheet number already exists in the project, * is appended automatically. Cards without a number are skipped."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="3" Background="#0A0A12"
                    BorderBrush="#1976D2" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="UI_status_main" Text="1 sheet ready to create"
                                   Foreground="{StaticResource blueTxt}" FontSize="11"/>
                        <TextBlock x:Name="UI_status_info" Text="Title block: -"
                                   Foreground="{StaticResource peach}" FontSize="10"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="GENERATE SHEETS"
                            Style="{StaticResource PrimaryBtn}"
                            Click="UIe_btn_run"
                            Width="200" Height="40"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
