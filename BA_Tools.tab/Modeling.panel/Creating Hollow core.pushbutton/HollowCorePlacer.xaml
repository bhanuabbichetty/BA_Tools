<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="540" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ── Slim Scrollbar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── Primary Button (Blue) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Button (Dark outline) ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button  ("Close" text, blue outline) ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox  (pure white text, always readable) ── -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#1976D2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="bd" Property="Background" Value="#0E0E1E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════
         OUTER SHELL — full dark, logo-blue border, rounded
    ════════════════════════════════════════════════════════ -->
    <Border Background="#0A0A12"
            CornerRadius="12"
            BorderBrush="#0A0A12"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 ROW 0 — TITLE BAR  (drag to move)
            ══════════════════════════════════════════════ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── 42 x 42 Logo badge ── -->
                    <Border Grid.Column="0"
                            Background="#1976D2"
                            CornerRadius="8"
                            Width="42" Height="42"
                            VerticalAlignment="Center">
                        <TextBlock Text="BA"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- ── Heading  FontSize=18 ── -->
                    <TextBlock Grid.Column="1"
                               Text="HOLLOW CORE PLACER"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <!-- ── "Close" button ── -->
                    <Button x:Name="btnClose"
                            Grid.Column="2"
                            Content="Close"
                            Style="{StaticResource CloseButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 1 — SUBTITLE
            ══════════════════════════════════════════════ -->
            <TextBlock Grid.Row="1"
                       Text="Place hollow core slabs below floor"
                       FontSize="11"
                       FontFamily="Segoe UI"
                       Foreground="#FFCDA2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- ══════════════════════════════════════════
                 ROW 2 — SELECTED FLOOR BAR
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="#0E0E1A"
                    Margin="16,4,16,4"
                    CornerRadius="8"
                    BorderBrush="#1976D2"
                    BorderThickness="0.8">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="📐"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="SELECTED FLOOR"
                                   FontSize="9"
                                   FontFamily="Segoe UI"
                                   FontWeight="Bold"
                                   Foreground="#8888AA"/>
                        <TextBlock x:Name="txtFloorInfo"
                                   Text="Selected: Floor (ID: 12345)"
                                   FontSize="13"
                                   FontFamily="Segoe UI"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 3 — SCROLLABLE MAIN CONTENT
            ══════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          Margin="16,8,16,0"
                          Padding="0,0,4,0">
                <StackPanel>

                    <!-- ── Z OFFSET CARD ───────────────────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <StackPanel>

                            <TextBlock Text="Z OFFSET (mm) — OPTIONAL"
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="#E0E0FF"
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="Leave 0 for floor bottom  |  Negative = below  |  Positive = above"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       Foreground="#FFCDA2"
                                       Margin="0,0,0,12"/>

                            <!-- Input row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bright-white Z offset input -->
                                <TextBox x:Name="txtZOffset"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="0.0"
                                         VerticalContentAlignment="Center"
                                         Height="44"/>

                                <!-- mm badge -->
                                <Border Grid.Column="1"
                                        Background="#0A0A14"
                                        CornerRadius="6"
                                        BorderBrush="#1976D2"
                                        BorderThickness="0.8"
                                        Width="50" Height="44"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="mm"
                                               FontSize="12"
                                               FontFamily="Segoe UI"
                                               FontWeight="SemiBold"
                                               Foreground="#5A7FAA"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Rotate checkbox -->
                            <CheckBox x:Name="chkRotate90"
                                      Content="Rotate 90° (if span direction is wrong)"
                                      Foreground="#C0C0E0"
                                      FontFamily="Segoe UI"
                                      FontSize="12"
                                      Margin="0,14,0,0"
                                      Padding="8,0">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="CheckBox">
                                                    <StackPanel Orientation="Horizontal" Cursor="Hand">
                                                        <Border x:Name="checkBorder"
                                                                Width="20" Height="20"
                                                                Background="#0A0A14"
                                                                BorderBrush="#1976D2"
                                                                BorderThickness="1.5"
                                                                CornerRadius="4"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center">
                                                            <Path x:Name="checkMark"
                                                                  Data="M 2,6 L 6,10 L 13,2"
                                                                  Stroke="White"
                                                                  StrokeThickness="2"
                                                                  Visibility="Collapsed"
                                                                  Margin="2"/>
                                                        </Border>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="checkBorder" Property="Background" Value="#1976D2"/>
                                                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="#1976D2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="#2196F3"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>

                        </StackPanel>
                    </Border>

                    <!-- ── FAMILY HEADER CARD ──────────────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="🏗️"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SELECT HOLLOW CORE FAMILY"
                                           FontSize="10"
                                           FontFamily="Segoe UI"
                                           FontWeight="Bold"
                                           Foreground="#8888AA"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="txtFamilyCount"
                                           Text="Available: 0 family types"
                                           FontSize="13"
                                           FontFamily="Segoe UI"
                                           FontWeight="SemiBold"
                                           Foreground="#1976D2"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── FAMILY LIST ─────────────────────── -->
                    <Border Background="#0A0A12"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="6">
                        <ItemsControl x:Name="lstFamilyTypes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding DisplayText}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 GroupName="FamilySelection"
                                                 Foreground="#C8C8E8"
                                                 FontFamily="Segoe UI"
                                                 FontSize="13"
                                                 Margin="0,2"
                                                 Padding="12,10">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="itemBorder"
                                                                    Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="6"
                                                                    Padding="12,10"
                                                                    Margin="0,2"
                                                                    Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <!-- Radio circle -->
                                                                    <Border x:Name="radioBorder"
                                                                            Width="20" Height="20"
                                                                            Background="#0A0A14"
                                                                            BorderBrush="#1976D2"
                                                                            BorderThickness="1.5"
                                                                            CornerRadius="10"
                                                                            Margin="0,0,14,0"
                                                                            VerticalAlignment="Center">
                                                                        <Ellipse x:Name="radioMark"
                                                                                 Width="10" Height="10"
                                                                                 Fill="White"
                                                                                 Visibility="Collapsed"/>
                                                                    </Border>
                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="radioMark" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="radioBorder" Property="Background" Value="#1976D2"/>
                                                                    <Setter TargetName="radioBorder" Property="BorderBrush" Value="#1976D2"/>
                                                                    <Setter TargetName="itemBorder" Property="Background" Value="#131326"/>
                                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#1976D2"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="itemBorder" Property="Background" Value="#0E0E20"/>
                                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#1976D2"/>
                                                                    <Setter TargetName="radioBorder" Property="BorderBrush" Value="#2196F3"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════
                 ROW 4 — FOOTER
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="4"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status -->
                    <TextBlock x:Name="txtStatus"
                               Grid.Column="0"
                               Text="Select a hollow core family type"
                               Foreground="#1976D2"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Cancel -->
                    <Button x:Name="btnCancel"
                            Grid.Column="1"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Width="95" Height="36"
                            Margin="0,0,10,0"/>

                    <!-- Place Hollow Cores -->
                    <Button x:Name="btnPlace"
                            Grid.Column="2"
                            Content="PLACE HOLLOW CORES"
                            Style="{StaticResource PrimaryButton}"
                            Width="180" Height="36"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
