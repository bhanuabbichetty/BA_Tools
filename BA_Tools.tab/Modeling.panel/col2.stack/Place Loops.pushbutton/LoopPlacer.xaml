<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="980" Height="760"
        MinWidth="920" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ══ PRIMARY BUTTON ══ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ SECONDARY BUTTON ══ -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#C0C0E0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#111120"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ CLOSE BUTTON ══ -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ DARK TEXTBOX ══ -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#1976D2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="10,0,10,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#06060E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
        ══ FULL DARK COMBOBOX ══
        A complete ControlTemplate + ComboBoxItem override is needed to
        prevent WPF from rendering the selected-item area and dropdown
        with the system light theme.
        -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background"       Value="#0A0A14"/>
            <Setter Property="Foreground"       Value="#FFFFFF"/>
            <Setter Property="BorderBrush"      Value="#1976D2"/>
            <Setter Property="BorderThickness"  Value="0.8"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Height"           Value="36"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Invisible toggle covers full control -->
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tb"
                                                Background="#0A0A14"
                                                BorderBrush="#1976D2"
                                                BorderThickness="0.8"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="▾"
                                                           Foreground="#1976D2"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb" Property="BorderBrush" Value="#2196F3"/>
                                                <Setter TargetName="tb" Property="Background"   Value="#0D1020"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="tb" Property="BorderBrush" Value="#2196F3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Selected-item display — forces white foreground -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,30,0"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="#FFFFFF"
                                              TextElement.FontFamily="Segoe UI"
                                              TextElement.FontSize="13"/>

                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#0A0A14"
                                        BorderBrush="#1976D2"
                                        BorderThickness="0.8"
                                        CornerRadius="0,0,6,6">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <!-- Dark item style for every dropdown entry -->
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background"  Value="#0A0A14"/>
                    <Setter Property="Foreground"  Value="#FFFFFF"/>
                    <Setter Property="FontFamily"  Value="Segoe UI"/>
                    <Setter Property="FontSize"    Value="13"/>
                    <Setter Property="Padding"     Value="12,8"/>
                    <Setter Property="Cursor"      Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter
                                        TextElement.Foreground="{TemplateBinding Foreground}"
                                        TextElement.FontFamily="Segoe UI"
                                        TextElement.FontSize="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1A2A40"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                        <Setter Property="Foreground"                  Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Condition Card RadioButton -->
        <Style x:Key="ConditionCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#0A0A12"
                                BorderBrush="#2A2A4A" BorderThickness="1.5"
                                CornerRadius="8" Padding="10,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="Background"  Value="#0D1B2E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini side-selector RadioButton -->
        <Style x:Key="SideCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#0A0A12"
                                BorderBrush="#2A2A4A" BorderThickness="1"
                                CornerRadius="6" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="Background"  Value="#0D1B2E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0C0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,0,12"/>
        </Style>

    </Window.Resources>

    <!-- ══ OUTER SHELL ══ -->
    <Border Background="#0A0A12" CornerRadius="12" BorderBrush="#0A0A12" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══ TITLE BAR ══ -->
            <Border x:Name="headerDragArea" Grid.Row="0"
                    Background="#0E0E1A" CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1976D2" CornerRadius="8"
                            Width="42" Height="42" VerticalAlignment="Center">
                        <TextBlock Text="BA" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="LOOP PLACER"
                               FontSize="18" FontWeight="Bold" Foreground="White"
                               FontFamily="Segoe UI" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <Button x:Name="btnClose" Grid.Column="2" Content="Close"
                            Style="{StaticResource CloseButton}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══ SUBTITLE ══ -->
            <TextBlock Grid.Row="1"
                       Text="Groove Height = wall height - Elevation from Level  •  Offsets can use Exterior/Interior side  •  Single instance per position"
                       FontSize="11" FontFamily="Segoe UI" Foreground="#FFCDA2"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- ══ MAIN CONTENT ══ -->
            <ScrollViewer Grid.Row="2"
                          Margin="16,10,16,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────────────── LEFT PANEL ─────────────── -->
                <StackPanel Grid.Column="0">

                    <!-- Wall Selection -->
                    <Border Background="#0E0E1A" CornerRadius="8" BorderBrush="#1976D2"
                            BorderThickness="0.8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="WALL SELECTION" Style="{StaticResource SectionLabel}"/>
                            <Button x:Name="btnSelectWall" Content="▶  SELECT WALL"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="38" Margin="0,0,0,10"/>
                            <Border Background="#0A0A12" BorderBrush="#1E1E2E"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock x:Name="txtWallName"
                                               Text="No wall selected"
                                               Foreground="#606080" FontFamily="Segoe UI"
                                               FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="txtWallDetails"
                                               Text="" Foreground="#404060"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="txtWallHeightInfo"
                                               Text="" Foreground="#64B5F6"
                                               FontFamily="Segoe UI" FontSize="12"
                                               FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Family Selection -->
                    <Border Background="#0E0E1A" CornerRadius="8" BorderBrush="#1976D2"
                            BorderThickness="0.8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="LOOP FAMILY" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="Search:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtFamilySearch"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34" Margin="0,0,0,10"/>
                            <TextBlock Text="Family:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbFamily"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="Type:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbType"
                                      Style="{StaticResource DarkComboBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Loop Family Parameters -->
                    <Border Background="#0E0E1A" CornerRadius="8" BorderBrush="#1976D2"
                            BorderThickness="0.8" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="FAMILY PARAMETERS" Style="{StaticResource SectionLabel}"/>

                            <!-- Groove Height — read-only, auto from wall -->
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Foreground="#64B5F6">↕</Run>
                                <Run Text="  Groove Height  (auto = wall height)"/>
                            </TextBlock>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtGrooveHeight"
                                         Grid.Column="0"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="34" Text="—"
                                         IsReadOnly="True"
                                         Foreground="#64B5F6"/>
                                <Border Grid.Column="1" Background="#0A0A14" CornerRadius="6"
                                        BorderBrush="#1976D2" BorderThickness="0.8"
                                        Width="44" Height="34" Margin="8,0,0,0">
                                    <TextBlock Text="mm" FontSize="11" FontFamily="Segoe UI"
                                               FontWeight="SemiBold" Foreground="#5A7FAA"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Elevation from Level -->
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Foreground="#90CAF9">↥</Run>
                                <Run Text="  Elevation from Level (mm)"/>
                            </TextBlock>
                            <TextBox x:Name="txtElevFromLevel"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34" Text="16"
                                     Margin="0,0,0,10"/>

                            <!-- Offset side selector -->
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Foreground="#B39DDB">◫</Run>
                                <Run Text="  Offset Side"/>
                            </TextBlock>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="rbOffsetExterior" Grid.Column="0"
                                             GroupName="OffsetSide" IsChecked="True"
                                             Style="{StaticResource SideCard}">
                                    <TextBlock Text="Exterior" Foreground="White"
                                               FontFamily="Segoe UI" FontSize="12"/>
                                </RadioButton>
                                <RadioButton x:Name="rbOffsetInterior" Grid.Column="2"
                                             GroupName="OffsetSide"
                                             Style="{StaticResource SideCard}">
                                    <TextBlock Text="Interior" Foreground="White"
                                               FontFamily="Segoe UI" FontSize="12"/>
                                </RadioButton>
                            </Grid>

                            <!-- C/C Spacing -->
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Foreground="#FFCDA2">⟷</Run>
                                <Run Text="  C/C Spacing (mm)"/>
                            </TextBlock>
                            <TextBox x:Name="txtSpacing"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34" Text="600"
                                     Margin="0,0,0,10"/>

                            <!-- Loops Number + Auto checkbox -->
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Foreground="#81C784">#</Run>
                                <Run Text="  Loops Number"/>
                            </TextBlock>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtLoopsNumber"
                                         Grid.Column="0"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="34" Text="4"/>
                                <Border Grid.Column="2" Background="#1A1A2A"
                                        BorderBrush="#1976D2" BorderThickness="0.8"
                                        CornerRadius="6" Padding="10,0" Height="34">
                                    <CheckBox x:Name="chkAutoLoops"
                                              Content="Auto" IsChecked="True"
                                              Foreground="#FFCDA2"
                                              FontFamily="Segoe UI" FontSize="12"
                                              VerticalAlignment="Center" Cursor="Hand"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="Auto  =  ⌈ Wall Height ÷ C/C Spacing ⌉"
                                       FontSize="10" FontFamily="Segoe UI"
                                       Foreground="#404060" Margin="0,0,0,10"/>

                            <!-- From Start -->
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Foreground="#CE93D8">◄</Run>
                                <Run Text="  From Start (mm)"/>
                            </TextBlock>
                            <TextBox x:Name="txtFromStart"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34" Text="300"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ─────────────── RIGHT PANEL ─────────────── -->
                <StackPanel Grid.Column="2">

                    <!-- Condition Selector -->
                    <Border Background="#0E0E1A" CornerRadius="8" BorderBrush="#1976D2"
                            BorderThickness="0.8" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PLACEMENT CONDITION" Style="{StaticResource SectionLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cond 1 -->
                                <RadioButton x:Name="rbCond1" Grid.Column="0"
                                             Style="{StaticResource ConditionCard}"
                                             IsChecked="True" GroupName="Conditions">
                                    <StackPanel>
                                        <TextBlock Text="CONDITION 1" Foreground="#1976D2"
                                                   FontFamily="Segoe UI" FontSize="10"
                                                   FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="Both Edges" Foreground="White"
                                                   FontFamily="Segoe UI" FontSize="13"
                                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock FontFamily="Consolas" FontSize="10"
                                                   TextAlignment="Center">
                                            <Run Foreground="#FFCDA2">▌</Run>
                                            <Run Foreground="#2A3A5A">══════════</Run>
                                            <Run Foreground="#FFCDA2">▐</Run>
                                            <LineBreak/>
                                            <Run Foreground="#303055">│                │</Run>
                                        </TextBlock>
                                        <TextBlock Text="Loop on each end face"
                                                   Foreground="#FFCDA2" FontFamily="Segoe UI"
                                                   FontSize="10" TextWrapping="Wrap"
                                                   TextAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Cond 2 -->
                                <RadioButton x:Name="rbCond2" Grid.Column="2"
                                             Style="{StaticResource ConditionCard}"
                                             GroupName="Conditions">
                                    <StackPanel>
                                        <TextBlock Text="CONDITION 2" Foreground="#1976D2"
                                                   FontFamily="Segoe UI" FontSize="10"
                                                   FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="Both on Face" Foreground="White"
                                                   FontFamily="Segoe UI" FontSize="13"
                                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock FontFamily="Consolas" FontSize="10"
                                                   TextAlignment="Center">
                                            <Run Foreground="#303055">┌──────────────┐</Run>
                                            <LineBreak/>
                                            <Run Foreground="#303055">│ </Run>
                                            <Run Foreground="#64B5F6">▌</Run>
                                            <Run Foreground="#303055">          </Run>
                                            <Run Foreground="#64B5F6">▐</Run>
                                            <Run Foreground="#303055"> │</Run>
                                            <LineBreak/>
                                            <Run Foreground="#303055">└──────────────┘</Run>
                                        </TextBlock>
                                        <TextBlock Text="Loops on long face at offsets"
                                                   Foreground="#FFCDA2" FontFamily="Segoe UI"
                                                   FontSize="10" TextWrapping="Wrap"
                                                   TextAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Cond 3 -->
                                <RadioButton x:Name="rbCond3" Grid.Column="4"
                                             Style="{StaticResource ConditionCard}"
                                             GroupName="Conditions">
                                    <StackPanel>
                                        <TextBlock Text="CONDITION 3" Foreground="#1976D2"
                                                   FontFamily="Segoe UI" FontSize="10"
                                                   FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="Mixed" Foreground="White"
                                                   FontFamily="Segoe UI" FontSize="13"
                                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock FontFamily="Consolas" FontSize="10"
                                                   TextAlignment="Center">
                                            <Run Foreground="#FFCDA2">▌</Run>
                                            <Run Foreground="#303055">═════════════┐</Run>
                                            <LineBreak/>
                                            <Run Foreground="#303055">│            </Run>
                                            <Run Foreground="#64B5F6">▐</Run>
                                            <Run Foreground="#303055"> │</Run>
                                            <LineBreak/>
                                            <Run Foreground="#303055">└──────────────┘</Run>
                                        </TextBlock>
                                        <TextBlock Text="One on edge, one on face"
                                                   Foreground="#FFCDA2" FontFamily="Segoe UI"
                                                   FontSize="10" TextWrapping="Wrap"
                                                   TextAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Dynamic Condition Parameters -->
                    <Border Background="#0E0E1A" CornerRadius="8" BorderBrush="#1976D2"
                            BorderThickness="0.8" Padding="14,12" Margin="0,0,0,10">
                        <Grid>

                            <!-- Cond 1 params -->
                            <StackPanel x:Name="pnlCond1" Visibility="Visible">
                                <TextBlock Text="CONDITION 1 — BOTH END FACES"
                                           Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Foreground="#FFCDA2">◄</Run>
                                            <Run Text="  Inset at Start Face (mm)"/>
                                        </TextBlock>
                                        <TextBox x:Name="txtC1StartInset"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Height="34" Text="50"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Text="Inset at End Face (mm)  "/>
                                            <Run Foreground="#FFCDA2">►</Run>
                                        </TextBlock>
                                        <TextBox x:Name="txtC1EndInset"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Height="34" Text="50"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="#0A0A12" BorderBrush="#1976D2"
                                        BorderThickness="0.8" CornerRadius="6"
                                        Padding="10,8" Margin="0,12,0,0">
                                    <TextBlock FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#FFCDA2" TextWrapping="Wrap" LineHeight="15">
                                        <Run Foreground="#FFCDA2">▌▐</Run>
                                        <Run Text=" One instance placed vertically on each end face."/>
                                        <LineBreak/>
                                        <Run Text="     Inset moves the instance inward from the outer wall edge."/>
                                        <LineBreak/>
                                        <Run Text="     Groove Height = wall height  (set automatically)."/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Cond 2 params -->
                            <StackPanel x:Name="pnlCond2" Visibility="Collapsed">
                                <TextBlock Text="CONDITION 2 — BOTH ON EXTERIOR LONG FACE"
                                           Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Foreground="#FFCDA2">◄</Run>
                                            <Run Text="  Offset from Start (mm)"/>
                                        </TextBlock>
                                        <TextBox x:Name="txtC2LeftOffset"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Height="34" Text="300"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Text="Offset from End (mm)  "/>
                                            <Run Foreground="#FFCDA2">►</Run>
                                        </TextBlock>
                                        <TextBox x:Name="txtC2RightOffset"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Height="34" Text="300"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="#0A0A12" BorderBrush="#1976D2"
                                        BorderThickness="0.8" CornerRadius="6"
                                        Padding="10,8" Margin="0,12,0,0">
                                    <TextBlock FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#FFCDA2" TextWrapping="Wrap" LineHeight="15">
                                        <Run Foreground="#64B5F6">▌▐</Run>
                                        <Run Text=" Two instances on the selected side face (Exterior/Interior)."/>
                                        <LineBreak/>
                                        <Run Text="     Each placed at the specified offset from its respective wall end."/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Cond 3 params -->
                            <StackPanel x:Name="pnlCond3" Visibility="Collapsed">
                                <TextBlock Text="CONDITION 3 — MIXED (EDGE + FACE)"
                                           Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Edge Loop at which end?"
                                           Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="rbC3EdgeStart" Grid.Column="0"
                                                 GroupName="EdgeSide" IsChecked="True"
                                                 Style="{StaticResource SideCard}">
                                        <TextBlock Text="Start End" Foreground="White"
                                                   FontFamily="Segoe UI" FontSize="12"/>
                                    </RadioButton>
                                    <RadioButton x:Name="rbC3EdgeEnd" Grid.Column="2"
                                                 GroupName="EdgeSide"
                                                 Style="{StaticResource SideCard}">
                                        <TextBlock Text="Finish End" Foreground="White"
                                                   FontFamily="Segoe UI" FontSize="12"/>
                                    </RadioButton>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Foreground="#FFCDA2">▌</Run>
                                            <Run Text="  Edge Inset (mm)"/>
                                        </TextBlock>
                                        <TextBox x:Name="txtC3EdgeInset"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Height="34" Text="50"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Foreground="#64B5F6">▐</Run>
                                            <Run Text="  Face Offset (mm)"/>
                                        </TextBlock>
                                        <TextBox x:Name="txtC3FaceOffset"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Height="34" Text="300"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="#0A0A12" BorderBrush="#1976D2"
                                        BorderThickness="0.8" CornerRadius="6"
                                        Padding="10,8">
                                    <TextBlock FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#FFCDA2" TextWrapping="Wrap" LineHeight="15">
                                        <Run Foreground="#FFCDA2">▌</Run>
                                        <Run Text=" End face instance — inset inward from chosen wall end."/>
                                        <LineBreak/>
                                        <Run Foreground="#64B5F6">▐</Run>
                                        <Run Text=" Side-face instance — offset from the opposite end."/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- Summary Card -->
                    <Border Background="#0E0E1A" CornerRadius="8" BorderBrush="#1976D2"
                            BorderThickness="0.8" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="PLACEMENT SUMMARY" Style="{StaticResource SectionLabel}"/>
                            <Border Background="#0A0A12" BorderBrush="#1E1E2E"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="txtSummaryWall"
                                                   Text="Wall: —"
                                                   FontSize="12" FontFamily="Segoe UI"
                                                   Foreground="#1976D2" FontWeight="SemiBold"
                                                   Margin="0,0,0,5" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtSummaryFamily"
                                                   Text="Family: —"
                                                   FontSize="12" FontFamily="Segoe UI"
                                                   Foreground="#C8C8E8"
                                                   Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtSummaryCondition"
                                                   Text="Condition: —"
                                                   FontSize="12" FontFamily="Segoe UI"
                                                   Foreground="#C8C8E8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="txtSummaryHeight"
                                                   Text="Groove Height: —"
                                                   FontSize="12" FontFamily="Segoe UI"
                                                   Foreground="#64B5F6" FontWeight="SemiBold"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock x:Name="txtSummarySpacing"
                                                   Text="C/C Spacing: —"
                                                   FontSize="12" FontFamily="Segoe UI"
                                                   Foreground="#C8C8E8" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="txtSummaryLoops"
                                                   Text="Loops Number: —"
                                                   FontSize="12" FontFamily="Segoe UI"
                                                   Foreground="#FFCDA2" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
            </ScrollViewer>

            <!-- ══ FOOTER ══ -->
            <Border Grid.Row="3" Background="#0E0E1A" CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtStatus" Grid.Column="0"
                               Text="Select a wall to begin"
                               Foreground="#1976D2" FontFamily="Segoe UI" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="btnCancel" Grid.Column="1" Content="CANCEL"
                            Style="{StaticResource SecondaryButton}" Width="110" Height="36"/>
                    <Button x:Name="btnPlace" Grid.Column="3" Content="▶  PLACE LOOPS"
                            Style="{StaticResource PrimaryButton}"
                            Width="180" Height="36" IsEnabled="False"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
