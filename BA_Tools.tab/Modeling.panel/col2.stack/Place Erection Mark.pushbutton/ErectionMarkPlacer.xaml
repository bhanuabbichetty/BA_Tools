<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="820" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#1976D2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="10,0,10,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0A0A14"/>
            <Setter Property="Foreground" Value="#0A0A12"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E6EEFF"/>
                        <Setter Property="Background" Value="#0A0A14"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#14385C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C0C0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Section Label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Window.Resources>

    <!-- ══ OUTER SHELL ══ -->
    <Border Background="#0A0A12" CornerRadius="12" BorderBrush="#0A0A12" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══ ROW 0 — TITLE BAR ══ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1976D2" CornerRadius="8"
                            Width="42" Height="42" VerticalAlignment="Center">
                        <TextBlock Text="BA" FontSize="20" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="ERECTION MARK PLACER"
                               FontSize="18" FontWeight="Bold" Foreground="White"
                               FontFamily="Segoe UI" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <Button x:Name="btnClose" Grid.Column="2" Content="Close"
                            Style="{StaticResource CloseButton}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══ ROW 1 — SUBTITLE ══ -->
            <TextBlock Grid.Row="1"
                       Text="Place Erection Marks at centre of Exterior wall faces with height control"
                       FontSize="12" FontFamily="Segoe UI" Foreground="#FFCDA2"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- ══ ROW 2 — MAIN CONTENT (2 columns) ══ -->
            <ScrollViewer Grid.Row="2"
                          Margin="16,10,16,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT PANEL ── -->
                <StackPanel Grid.Column="0">

                    <!-- Selected Walls Card -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="14,12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SELECTED WALLS"
                                           Style="{StaticResource SectionLabel}"
                                           Margin="0"/>
                                <TextBlock x:Name="txtWallCount"
                                           Grid.Column="1"
                                           Text="0 Walls"
                                           FontSize="11" FontFamily="Segoe UI"
                                           FontWeight="SemiBold"
                                           Foreground="#FFC107"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Border Background="#0A0A12"
                                    BorderBrush="#1E1E2E"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    MaxHeight="130">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="txtWallList"
                                               Text="Walls will appear here after selection..."
                                               FontSize="11" FontFamily="Segoe UI"
                                               Foreground="#606080"
                                               TextWrapping="Wrap"
                                               LineHeight="18"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Family Selection Card -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="LOOP FAMILY"
                                       Style="{StaticResource SectionLabel}"/>

                            <TextBlock Text="Search:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtFamilySearch"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="34"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="Family:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbFamily"
                                      Style="{StaticResource DarkComboBox}"
                                      Height="36" Margin="0,0,0,12"/>

                            <TextBlock Text="Type:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbType"
                                      Style="{StaticResource DarkComboBox}"
                                      Height="36"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ── RIGHT PANEL ── -->
                <StackPanel Grid.Column="2">

                    <!-- Height Card -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="14,12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="FAMILY PARAMETERS"
                                       Style="{StaticResource SectionLabel}"/>

                            <TextBlock Text="Elevation from Level (mm)"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtHeight"
                                         Grid.Column="0"
                                         Style="{StaticResource DarkTextBox}"
                                         Text="2000"
                                         Height="36"
                                         FontSize="12"
                                         Padding="10,4"/>
                                <Border Grid.Column="1"
                                        Background="#0A0A14"
                                        CornerRadius="6"
                                        BorderBrush="#1976D2"
                                        BorderThickness="0.8"
                                        Width="50" Height="36"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="mm"
                                               FontSize="11" FontFamily="Segoe UI"
                                               FontWeight="SemiBold"
                                               Foreground="#5A7FAA"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Offset Side"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbFaceSide"
                                      Style="{StaticResource DarkComboBox}"
                                      Height="36"
                                      Margin="0,0,0,12"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Exterior"/>
                                <ComboBoxItem Content="Interior"/>
                            </ComboBox>

                            <TextBlock Text="Quick Presets:"
                                       Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnPreset1000" Content="1000"
                                        Style="{StaticResource SecondaryButton}"
                                        Grid.Column="0" Height="30"
                                        Margin="0,0,3,0" FontSize="11"/>
                                <Button x:Name="btnPreset1500" Content="1500"
                                        Style="{StaticResource SecondaryButton}"
                                        Grid.Column="1" Height="30"
                                        Margin="2,0,2,0" FontSize="11"/>
                                <Button x:Name="btnPreset2000" Content="2000"
                                        Style="{StaticResource SecondaryButton}"
                                        Grid.Column="2" Height="30"
                                        Margin="2,0,2,0" FontSize="11"/>
                                <Button x:Name="btnPreset2500" Content="2500"
                                        Style="{StaticResource SecondaryButton}"
                                        Grid.Column="3" Height="30"
                                        Margin="3,0,0,0" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Summary Card -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="14,12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PLACEMENT SUMMARY"
                                       Style="{StaticResource SectionLabel}"/>
                            <Border Background="#0A0A12"
                                    BorderBrush="#1E1E2E"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock x:Name="txtSummaryWalls"
                                               Text="Walls: 0"
                                               FontSize="12" FontFamily="Segoe UI"
                                               FontWeight="SemiBold"
                                               Foreground="#1976D2"
                                               Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtSummaryFamily"
                                               Text="Family: Not selected"
                                               FontSize="11" FontFamily="Segoe UI"
                                               Foreground="#C8C8E8"
                                               Margin="0,0,0,4"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="txtSummaryHeight"
                                               Text="Height: 2000 mm"
                                               FontSize="11" FontFamily="Segoe UI"
                                               Foreground="#C8C8E8"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtSummaryFace"
                                               Text="Face Side: Exterior"
                                               FontSize="11" FontFamily="Segoe UI"
                                               Foreground="#C8C8E8"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="txtSummaryTotal"
                                               Text="Total Marks: 0"
                                               FontSize="11" FontFamily="Segoe UI"
                                               Foreground="#FFCDA2"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Info Card -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="ℹ  How it works"
                                       Foreground="#1976D2"
                                       FontFamily="Segoe UI"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#808090"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       LineHeight="14">
                                <Run Foreground="#FFCDA2" FontWeight="Bold">1.</Run>
                                <Run> Walls are selected before opening this window</Run>
                                <LineBreak/>
                                <Run Foreground="#FFCDA2" FontWeight="Bold">2.</Run>
                                <Run> Select family and type</Run>
                                <LineBreak/>
                                <Run Foreground="#FFCDA2" FontWeight="Bold">3.</Run>
                                <Run> Set height from the wall's base level</Run>
                                <LineBreak/>
                                <Run Foreground="#FFCDA2" FontWeight="Bold">4.</Run>
                                <Run> Click PLACE MARKS</Run>
                                <LineBreak/><LineBreak/>
                                <Run Foreground="#606080">Marks are placed on selected</Run>
                                <Run Foreground="#64B5F6"> Exterior/Interior Face</Run>
                                <Run Foreground="#606080"> at the horizontal centre of each wall.</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
            </ScrollViewer>

            <!-- ══ ROW 3 — FOOTER ══ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtStatus"
                               Grid.Column="0"
                               Text="Ready to place marks"
                               Foreground="#1976D2"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="btnPlace"
                            Grid.Column="1"
                            Content="PLACE MARKS"
                            Style="{StaticResource PrimaryButton}"
                            Width="160" Height="36"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
