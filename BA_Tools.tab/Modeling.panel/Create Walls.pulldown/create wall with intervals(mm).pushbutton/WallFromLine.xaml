<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="520" Height="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        x:Name="MainWindow">

    <Window.Resources>

        <!-- ── Slim Scrollbar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── Primary Button (Blue) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Button (Dark outline) ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark ComboBox ── -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- ── Dark TextBox ── -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Foreground" Value="#C8C8E8"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#C8C8E8"/>
        </Style>

        <!-- ── Dark CheckBox ── -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8C8E8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBorder"
                                    Width="16"
                                    Height="16"
                                    Background="#0A0A12"
                                    BorderBrush="#1976D2"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="checkMark"
                                      Data="M 0,4 L 3,7 L 8,0"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Margin="1"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Section Label ── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ── Field Label ── -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#808090"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════
         OUTER SHELL — full dark, no OS chrome, rounded
    ════════════════════════════════════════════════════════ -->
    <Border Background="#0A0A12"
            CornerRadius="12"
            BorderBrush="#0A0A12"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 ROW 0 — TITLE BAR
            ══════════════════════════════════════════════ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BA Logo Badge -->
                    <Border Grid.Column="0"
                            Background="#1976D2"
                            CornerRadius="8"
                            Width="42" Height="42"
                            VerticalAlignment="Center">
                        <TextBlock Text="BA"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="CREATE WALL FROM LINE"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <!-- Close Button -->
                    <Button x:Name="btnClose"
                            Grid.Column="2"
                            Content="Close"
                            Style="{StaticResource CloseButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 1 — SUBTITLE
            ══════════════════════════════════════════════ -->
            <TextBlock Grid.Row="1"
                       Text="Select line type, wall type and levels (Units: mm)"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       Foreground="#FFCDA2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- ══════════════════════════════════════════
                 ROW 2 — SCROLLABLE MAIN CONTENT
            ══════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Margin="16,8,16,0"
                          Padding="0,0,4,0">
                <StackPanel>

                    <!-- ── MAIN FORM CARD ─────────────────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="20,16"
                            Margin="0,0,0,10">
                        <StackPanel>

                            <TextBlock Text="WALL CONFIGURATION"
                                       Style="{StaticResource SectionLabel}"/>

                            <!-- 1. Line Type -->
                            <TextBlock Text="1. Select Line Type:"
                                       Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="cmbLineType"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,16"/>

                            <!-- 2. Wall Type -->
                            <TextBlock Text="2. Select Wall Type:"
                                       Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="cmbWallType"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,16"/>

                            <!-- 3. Base Level -->
                            <TextBlock Text="3. Select Base Level (From):"
                                       Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="cmbBaseLevel"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,8"/>

                            <!-- Base Offset -->
                            <TextBlock Text="   Base Offset (mm):"
                                       Foreground="#606080"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtBaseOffset"
                                     Text="0"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="32"
                                     Margin="0,0,0,16"/>

                            <!-- 4. Top Level -->
                            <TextBlock Text="4. Select Top Level (To):"
                                       Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="cmbTopLevel"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,8"/>

                            <!-- Top Offset -->
                            <TextBlock Text="   Top Offset (mm):"
                                       Foreground="#606080"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtTopOffset"
                                     Text="0"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="32"
                                     Margin="0,0,0,16"/>

                            <!-- 5. Wall Location Line -->
                            <TextBlock Text="5. Wall Location Line:"
                                       Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="cmbWallLocation"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,0">
                                <ComboBoxItem Content="Wall Centerline" IsSelected="True"/>
                                <ComboBoxItem Content="Finish Face: Exterior"/>
                                <ComboBoxItem Content="Finish Face: Interior"/>
                                <ComboBoxItem Content="Core Centerline"/>
                                <ComboBoxItem Content="Core Face: Exterior"/>
                                <ComboBoxItem Content="Core Face: Interior"/>
                            </ComboBox>

                        </StackPanel>
                    </Border>

                    <!-- ── SPLIT WALL OPTIONS CARD ───────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="20,16"
                            Margin="0,0,0,10">
                        <StackPanel>

                            <TextBlock Text="SPLIT WALL OPTIONS"
                                       Style="{StaticResource SectionLabel}"/>

                            <!-- Split CheckBox -->
                            <CheckBox x:Name="chkSplitWall"
                                      Content="Split wall at intervals"
                                      Style="{StaticResource DarkCheckBox}"
                                      Margin="0,0,0,14"/>

                            <!-- Interval Row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Interval:"
                                           Foreground="#808090"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           IsEnabled="{Binding ElementName=chkSplitWall, Path=IsChecked}"/>

                                <TextBox x:Name="txtInterval"
                                         Grid.Column="2"
                                         Text="3000"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="32"
                                         IsEnabled="{Binding ElementName=chkSplitWall, Path=IsChecked}"/>

                                <TextBlock Grid.Column="4"
                                           Text="mm"
                                           Foreground="#606080"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           IsEnabled="{Binding ElementName=chkSplitWall, Path=IsChecked}"/>
                            </Grid>

                            <!-- Joint Gap Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Joint Gap:"
                                           Foreground="#808090"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           IsEnabled="{Binding ElementName=chkSplitWall, Path=IsChecked}"/>

                                <TextBox x:Name="txtJointGap"
                                         Grid.Column="2"
                                         Text="16"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="32"
                                         IsEnabled="{Binding ElementName=chkSplitWall, Path=IsChecked}"/>

                                <TextBlock Grid.Column="4"
                                           Text="mm"
                                           Foreground="#606080"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           IsEnabled="{Binding ElementName=chkSplitWall, Path=IsChecked}"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- ── HOW IT WORKS CARD ──────────────── -->
                    <Border Background="#0E0E1A"
                            CornerRadius="8"
                            BorderBrush="#1976D2"
                            BorderThickness="0.8"
                            Padding="20,16"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ℹ  How it works"
                                       Foreground="#1976D2"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#FFCDA2"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       LineHeight="16">
                                After clicking CREATE WALLS, select lines in Revit.
                                Walls will be created from base to top level.
                                <LineBreak/>
                                <LineBreak/>
                                <Run Foreground="#FFCDA2" FontWeight="Bold">Units:</Run>
                                <Run Foreground="#808090"> All measurements are in millimeters (mm)</Run>
                                <LineBreak/>
                                <Run Foreground="#FFCDA2" FontWeight="Bold">Base/Top Offset:</Run>
                                <Run Foreground="#808090"> Adjust wall height above/below levels</Run>
                                <LineBreak/>
                                <Run Foreground="#FFCDA2" FontWeight="Bold">Interval:</Run>
                                <Run Foreground="#808090"> Distance between wall segments (e.g., 3000 mm)</Run>
                                <LineBreak/>
                                <Run Foreground="#FFCDA2" FontWeight="Bold">Joint Gap:</Run>
                                <Run Foreground="#808090"> Space between segments (e.g., 16 mm)</Run>
                                <LineBreak/>
                                <Run Foreground="#FFCDA2" FontWeight="Bold">Wall Location:</Run>
                                <Run Foreground="#808090"> Controls how the wall aligns to the line</Run>
                                <LineBreak/>
                                <Run Foreground="#FFCDA2" FontWeight="Bold">Split Walls:</Run>
                                <Run Foreground="#808090"> Divides long walls into segments at specified intervals</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════
                 ROW 3 — FOOTER
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status -->
                    <TextBlock x:Name="txtStatus"
                               Grid.Column="0"
                               Text="Ready — Configure settings and click CREATE WALLS"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#1976D2"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Create Walls Button -->
                    <Button x:Name="btnCreateWalls"
                            Grid.Column="2"
                            Content="CREATE WALLS"
                            Width="160"
                            Height="36"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Click to start wall creation. You will then select lines in Revit to create walls from."/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
