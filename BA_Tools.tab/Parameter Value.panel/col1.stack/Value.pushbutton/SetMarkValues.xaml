<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="780" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ── Slim Scrollbar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── Primary Button (Blue) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Button (Dark outline) ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark ComboBox ── -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- ── Dark TextBox ── -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Foreground" Value="#C8C8E8"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#C8C8E8"/>
        </Style>

        <!-- ── Section Label ── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ── Field Label ── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════
         OUTER SHELL — full dark, no OS chrome, rounded
    ════════════════════════════════════════════════════════ -->
    <Border Background="#0A0A12"
            CornerRadius="12"
            BorderBrush="#0A0A12"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 ROW 0 — TITLE BAR
            ══════════════════════════════════════════════ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BA Logo Badge -->
                    <Border Grid.Column="0"
                            Background="#1976D2"
                            CornerRadius="8"
                            Width="42" Height="42"
                            VerticalAlignment="Center">
                        <TextBlock Text="BA"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="MARK VALUE MANAGER"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <!-- Close Button -->
                    <Button x:Name="btnClose"
                            Grid.Column="2"
                            Content="Close"
                            Style="{StaticResource CloseButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 1 — SUBTITLE
            ══════════════════════════════════════════════ -->
            <TextBlock Grid.Row="1"
                       Text="Assign mark values to elements filtered by category, level and type"
                       FontSize="10"
                       FontFamily="Segoe UI"
                       Foreground="#FFCDA2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- ══════════════════════════════════════════
                 ROW 2 — MAIN CONTENT (two-column layout)
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="16,8,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────────────────────────────────────────
                     LEFT PANEL — Element Selection
                ───────────────────────────────────────────── -->
                <Border Grid.Column="0"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="16,14"
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <TextBlock Grid.Row="0"
                                   Text="ELEMENT SELECTION"
                                   Style="{StaticResource SectionLabel}"/>

                        <!-- Step 1: Category -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="STEP 1 — SELECT CATEGORY"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbCategory"
                                      Style="{StaticResource DarkComboBox}"/>
                        </StackPanel>

                        <!-- Step 2: Level -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                            <TextBlock Text="STEP 2 — SELECT LEVEL"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbLevel"
                                      Style="{StaticResource DarkComboBox}"
                                      IsEnabled="False"/>
                        </StackPanel>

                        <!-- Step 3: Type -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,12">
                            <TextBlock Text="STEP 3 — SELECT TYPE"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbType"
                                      Style="{StaticResource DarkComboBox}"
                                      IsEnabled="False"/>
                        </StackPanel>

                        <!-- Element count + info list -->
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Count badge row -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="SELECTED ELEMENTS"
                                           Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center"
                                           Margin="0"/>
                                <TextBlock x:Name="txtElementCount"
                                           Grid.Column="1"
                                           Text="0 elements"
                                           Foreground="#1976D2"
                                           FontFamily="Segoe UI"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Element list -->
                            <Border Grid.Row="1"
                                    Background="#0A0A12"
                                    BorderBrush="#1E1E2E"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBox x:Name="txtElementInfo"
                                         Style="{StaticResource DarkTextBox}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="10"
                                         Foreground="#A0A0C0"
                                         Text="Select category > level > type"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ─────────────────────────────────────────
                     RIGHT PANEL — Mark Assignment
                ───────────────────────────────────────────── -->
                <Border Grid.Column="1"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <TextBlock Grid.Row="0"
                                   Text="STEP 4 — ASSIGN MARKS"
                                   Style="{StaticResource SectionLabel}"/>

                        <!-- Method selector + Input Container -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">

                            <!-- Method ComboBox -->
                            <TextBlock Text="ASSIGNMENT METHOD"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbMethod"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,12"/>

                            <!-- Input Container -->
                            <Border Background="#0A0A12"
                                    BorderBrush="#1E1E2E"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,12"
                                    MinHeight="140">
                                <Grid x:Name="inputContainer">

                                    <!-- Single Value -->
                                    <StackPanel x:Name="panelSingleValue">
                                        <TextBlock Text="Mark Value:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtSingleValue"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Height="32"/>
                                    </StackPanel>

                                    <!-- Sequential Numbers -->
                                    <StackPanel x:Name="panelSequential" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Start Number:"
                                                           Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="txtSeqStart"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Text="1" Height="32"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Step:"
                                                           Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="txtSeqStep"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Text="1" Height="32"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Sequential with Prefix -->
                                    <StackPanel x:Name="panelSequentialPrefix" Visibility="Collapsed">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Start Number:"
                                                           Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="txtPrefixSeqStart"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Text="1" Height="32"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Step:"
                                                           Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="txtPrefixSeqStep"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Text="1" Height="32"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Prefix:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtPrefix"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Height="32"/>
                                    </StackPanel>

                                    <!-- Comma-Separated -->
                                    <StackPanel x:Name="panelCSV" Visibility="Collapsed">
                                        <TextBlock Text="Comma-separated values (or one per line):"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtCSV"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Height="110"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Preview section -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="PREVIEW"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,6"/>

                            <Border Grid.Row="1"
                                    Background="#0A0A12"
                                    BorderBrush="#1E1E2E"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBox x:Name="txtPreview"
                                         Style="{StaticResource DarkTextBox}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="10"
                                         Foreground="#A0A0C0"
                                         Text="Click 'PREVIEW' to see changes..."/>
                            </Border>
                        </Grid>

                    </Grid>
                </Border>

            </Grid>

            <!-- ══════════════════════════════════════════
                 ROW 3 — FOOTER
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Text -->
                    <TextBlock x:Name="txtStatus"
                               Grid.Column="0"
                               Text="Select elements and configure method"
                               Foreground="#1976D2"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Preview Button -->
                    <Button x:Name="btnPreview"
                            Grid.Column="1"
                            Content="PREVIEW"
                            Style="{StaticResource SecondaryButton}"
                            Width="130" Height="36"
                            Margin="0,0,10,0"
                            IsEnabled="False"/>

                    <!-- Apply Button -->
                    <Button x:Name="btnApply"
                            Grid.Column="2"
                            Content="APPLY MARKS"
                            Style="{StaticResource PrimaryButton}"
                            Width="150" Height="36"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
