<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BA_Tools"
        Width="950" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ── Slim Scrollbar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A0A12"/>
            <Setter Property="Width" Value="5"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ── Primary Button (Blue) ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C2C"/>
                                <Setter Property="Foreground" Value="#404055"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Button (Dark outline) ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22223A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Remove Button (Red) ── -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2A"/>
            <Setter Property="Foreground" Value="#A0A0C0"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1976D2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TextBox Style ── -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#1976D2"/>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════
         OUTER SHELL — full dark, no OS chrome, rounded
    ════════════════════════════════════════════════════════ -->
    <Border Background="#0A0A12"
            CornerRadius="12"
            BorderBrush="#0A0A12"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 ROW 0 — TITLE BAR (drag to move)
            ══════════════════════════════════════════════ -->
            <Border x:Name="headerDragArea"
                    Grid.Row="0"
                    Background="#0E0E1A"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#1976D2"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 42 x 42 Logo badge -->
                    <Border Grid.Column="0"
                            Background="#1976D2"
                            CornerRadius="8"
                            Width="42" Height="42"
                            VerticalAlignment="Center">
                        <TextBlock Text="BA"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Heading FontSize=18 -->
                    <TextBlock Grid.Column="1"
                               Text="REVISION MANAGER"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <!-- Close button -->
                    <Button x:Name="btnClose"
                            Grid.Column="2"
                            Content="Close"
                            Style="{StaticResource CloseButton}"
                            VerticalAlignment="Center"
                            Click="CloseWindow"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 1 — SUBTITLE
            ══════════════════════════════════════════════ -->
            <TextBlock Grid.Row="1"
                       Text="Manage and apply revisions to sheets"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       Foreground="#FFCDA2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- ══════════════════════════════════════════
                 ROW 2 — MAIN CONTENT (2 columns)
            ══════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="16,8,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ══ LEFT PANEL — REVISION LIST ══ -->
                <Border Grid.Column="0"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8"
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                        </Grid.RowDefinitions>

                        <!-- Filter -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="16,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="🔍 Filter:"
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="#8888AA"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <RadioButton x:Name="radio_all_revisions"
                                         Content="All"
                                         IsChecked="True"
                                         GroupName="RevFilter"
                                         Foreground="#C8C8E8"
                                         FontFamily="Segoe UI"
                                         FontSize="12"
                                         Margin="0,0,16,0"
                                         Checked="OnRevisionFilterChanged"/>
                            <RadioButton x:Name="radio_unissued_only"
                                         Content="Unissued"
                                         GroupName="RevFilter"
                                         Foreground="#C8C8E8"
                                         FontFamily="Segoe UI"
                                         FontSize="12"
                                         Checked="OnRevisionFilterChanged"/>
                        </StackPanel>

                        <!-- Revision List -->
                        <Border Grid.Row="1"
                                Background="#0A0A12"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Margin="10">
                            <ListBox x:Name="list_revisions"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#C8C8E8"
                                     FontFamily="Segoe UI"
                                     FontSize="12"
                                     SelectionMode="Multiple"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="UpdateRevisionCount">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="itemBorder"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            Margin="2"
                                                            CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="25"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      VerticalAlignment="Center"/>
                                                            <ContentPresenter Grid.Column="1"
                                                                              VerticalAlignment="Center"
                                                                              Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="itemBorder" Property="Background" Value="#1A1A2E"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="itemBorder" Property="Background" Value="#1976D2"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>

                        <!-- Selection Buttons -->
                        <Grid Grid.Row="2" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8">
                                <Button x:Name="btn_select_all_revisions"
                                        Content="Select All"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="100" Height="32"
                                        Margin="0,0,8,0"
                                        Click="SelectAllRevisions"/>
                                <Button x:Name="btn_clear_all_revisions"
                                        Content="Clear All"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="100" Height="32"
                                        Click="ClearAllRevisions"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1"
                                       x:Name="txt_revision_count"
                                       Text="Selected: 0 revisions"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       FontWeight="SemiBold"
                                       Foreground="#1976D2"
                                       HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Preview/Status -->
                        <Border Grid.Row="3"
                                Background="#0A0A12"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Margin="10,0,10,10"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="txt_status"
                                           Text="Select revisions and sheets to see preview..."
                                           FontSize="11"
                                           FontFamily="Segoe UI"
                                           Foreground="#FFCDA2"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- ══ RIGHT PANEL — SHEET SELECTION ══ -->
                <Border Grid.Column="1"
                        Background="#0E0E1A"
                        CornerRadius="8"
                        BorderBrush="#1976D2"
                        BorderThickness="0.8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search -->
                        <Grid Grid.Row="0" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="🔍 Filter:"
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="#8888AA"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1"
                                     x:Name="txt_sheet_filter"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnSheetFilterChanged"/>
                        </Grid>

                        <!-- Sheet List -->
                        <Border Grid.Row="1"
                                Background="#0A0A12"
                                BorderBrush="#1976D2"
                                BorderThickness="0.8"
                                CornerRadius="6"
                                Margin="10">
                            <ListBox x:Name="list_sheets"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#C8C8E8"
                                     FontFamily="Segoe UI"
                                     FontSize="12"
                                     SelectionMode="Multiple"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="UpdateSheetCount">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="itemBorder"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            Margin="2"
                                                            CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="25"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      VerticalAlignment="Center"/>
                                                            <ContentPresenter Grid.Column="1"
                                                                              VerticalAlignment="Center"
                                                                              Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="itemBorder" Property="Background" Value="#1A1A2E"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="itemBorder" Property="Background" Value="#1976D2"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>

                        <!-- Selection Buttons -->
                        <Grid Grid.Row="2" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8">
                                <Button x:Name="btn_select_all_sheets"
                                        Content="Select All"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="90" Height="32"
                                        Margin="0,0,8,0"
                                        Click="SelectAllSheets"/>
                                <Button x:Name="btn_clear_all_sheets"
                                        Content="Clear All"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="90" Height="32"
                                        Margin="0,0,8,0"
                                        Click="ClearAllSheets"/>
                                <Button x:Name="btn_select_filtered"
                                        Content="Select Filtered"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="110" Height="32"
                                        Click="SelectFiltered"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1"
                                       x:Name="txt_sheet_count"
                                       Text="Selected: 0 / 0"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       FontWeight="SemiBold"
                                       Foreground="#1976D2"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════
                 ROW 3 — ACTION BUTTONS
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#0E0E1A"
                    BorderBrush="#1976D2"
                    BorderThickness="0,1,0,1"
                    Padding="16,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="btn_show_report"
                            Content="View Report"
                            Style="{StaticResource SecondaryButton}"
                            Width="140" Height="40"
                            Margin="0,0,12,0"
                            Click="ShowReport"/>
                    <Button x:Name="btn_apply"
                            Content="Apply Revisions"
                            Style="{StaticResource PrimaryButton}"
                            Width="180" Height="40"
                            Margin="0,0,12,0"
                            Click="ApplyRevisions"/>
                    <Button x:Name="btn_remove"
                            Content="Remove Revisions"
                            Style="{StaticResource RemoveButton}"
                            Width="180" Height="40"
                            Click="RemoveRevisions"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 ROW 4 — FOOTER
            ══════════════════════════════════════════════ -->
            <Border Grid.Row="4"
                    Background="#0E0E1A"
                    CornerRadius="0,0,12,12">
                <TextBlock Text="Ready to manage revisions on sheets"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           Foreground="#1976D2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Border>
</Window>
